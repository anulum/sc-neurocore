# SC-NeuroCore — Stochastic Doctor Core

[package]
name = "stochastic_doctor_core"
version = "0.2.0"
edition = "2021"
authors = ["Miroslav Sotek <protoscience@anulum.li>"]
description = "SC-NeuroCore: Bitstream-level stochastic correlation analysis (Rust FFI core)"
license = "AGPL-3.0-or-later"

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]

[dev-dependencies]
criterion = { version = "0.5", features = ["html_reports"] }

[[bench]]
name = "doctor_bench"
harness = false
