# Preflight gate before a push: the gates that guard what the push touches, and no test suite.
# The hosted CI runs every gate and the whole suite on every push.
# Install: git config core.hooksPath .githooks
set -euo pipefail
echo "Running preflight (the gates of this change, no test suite)..."
python tools/preflight.py
