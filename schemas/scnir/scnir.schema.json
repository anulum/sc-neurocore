{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anulum.li/sc-neurocore/schemas/scnir/scnir.schema.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later; © Concepts 1996-2026 Miroslav Sotek. All rights reserved.; © Code 2020-2026 Miroslav Sotek. All rights reserved.",
  "title": "SC-NeuroCore SC-NIR Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "streams", "hierarchy"],
  "properties": {
    "schema_version": {
      "const": "sc-neurocore.scnir.v0.7"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stream"
      }
    },
    "hierarchy": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hierarchy_instance"
      }
    }
  },
  "$defs": {
    "hierarchy_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "module_name", "ports"],
      "properties": {
        "instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "module_name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hierarchy_port"
          }
        }
      }
    },
    "hierarchy_port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port_name", "direction", "stream_id", "signal_kind", "bit_width"],
      "properties": {
        "port_name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
        },
        "direction": {
          "enum": ["input", "output", "inout"]
        },
        "stream_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "signal_kind": {
          "enum": ["spike", "analogue_state", "weight"]
        },
        "bit_width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "layer",
        "bitstream_length",
        "encoding",
        "signal_kind",
        "delay_steps",
        "transforms",
        "precision",
        "source",
        "correlation_constraints",
        "online_learning"
      ],
      "properties": {
        "stream_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "layer": {
          "type": "string",
          "minLength": 1
        },
        "bitstream_length": {
          "type": "integer",
          "minimum": 1
        },
        "encoding": {
          "enum": [
            "unipolar",
            "bipolar",
            "low_discrepancy",
            "deterministic_replay",
            "stochastic_lfsr",
            "hardware_source"
          ]
        },
        "signal_kind": {
          "enum": ["spike", "analogue_state", "weight"]
        },
        "delay_steps": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          ]
        },
        "precision": {
          "$ref": "#/$defs/precision"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "transforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transform"
          }
        },
        "correlation_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/correlation_constraint"
          }
        },
        "online_learning": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/online_learning"
            }
          ]
        }
      }
    },
    "online_learning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "rule_id",
        "rule_family",
        "state_fields",
        "per_synapse_state_bits",
        "weight_bits",
        "trace_bits",
        "reward_bits",
        "learning_shift",
        "trace_decay_shift",
        "saturation_policy",
        "hidden_history_fields",
        "sequence_length_independent"
      ],
      "properties": {
        "schema_version": {
          "const": "sc-neurocore.online-o1.annotation.v1"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_family": {
          "const": "reward_modulated_stdp"
        },
        "state_fields": {
          "const": ["weight", "pre_trace", "post_trace", "eligibility"]
        },
        "per_synapse_state_bits": {
          "type": "integer",
          "minimum": 4
        },
        "weight_bits": {
          "type": "integer",
          "minimum": 1
        },
        "trace_bits": {
          "type": "integer",
          "minimum": 2
        },
        "reward_bits": {
          "type": "integer",
          "minimum": 1
        },
        "learning_shift": {
          "type": "integer",
          "minimum": 0
        },
        "trace_decay_shift": {
          "type": "integer",
          "minimum": 0
        },
        "saturation_policy": {
          "const": "signed_eligibility_unsigned_weight"
        },
        "hidden_history_fields": {
          "const": []
        },
        "sequence_length_independent": {
          "const": true
        }
      }
    },
    "precision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed",
        "total_bits",
        "fractional_bits",
        "accumulator_bits",
        "rounding",
        "overflow"
      ],
      "properties": {
        "signed": {
          "type": "boolean"
        },
        "total_bits": {
          "type": "integer",
          "minimum": 1
        },
        "fractional_bits": {
          "type": "integer",
          "minimum": 0
        },
        "accumulator_bits": {
          "type": "integer",
          "minimum": 1
        },
        "rounding": {
          "enum": ["nearest_even", "towards_zero", "stochastic", "floor", "ceil"]
        },
        "overflow": {
          "enum": ["saturate", "wrap", "error"]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "seed",
        "lfsr_polynomial",
        "tap_mask",
        "sobol_dimension",
        "halton_base",
        "replay_uri",
        "hardware_id"
      ],
      "properties": {
        "kind": {
          "enum": ["lfsr", "sobol", "halton", "replay", "hardware"]
        },
        "seed": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "lfsr_polynomial": {
          "type": ["string", "null"]
        },
        "tap_mask": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "sobol_dimension": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "halton_base": {
          "type": ["integer", "null"],
          "minimum": 2
        },
        "replay_uri": {
          "type": ["string", "null"]
        },
        "hardware_id": {
          "type": ["string", "null"]
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "position", "comparison", "values"],
      "properties": {
        "kind": {
          "enum": ["threshold"]
        },
        "position": {
          "enum": ["source", "destination"]
        },
        "comparison": {
          "enum": ["greater_than"]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "correlation_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peer_stream_id", "policy", "max_abs_correlation", "seed_domain"],
      "properties": {
        "peer_stream_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "policy": {
          "enum": [
            "independent",
            "must_share_source",
            "must_decorrelate",
            "max_correlation",
            "seed_isolation_domain"
          ]
        },
        "max_abs_correlation": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "seed_domain": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
