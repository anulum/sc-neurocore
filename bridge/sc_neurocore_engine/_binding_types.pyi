# SC-NeuroCore — Native contracts consumed by Python facades

"""Declare the PyO3 result and argument types used by the Python facades."""

from collections.abc import Sequence
from typing import Protocol

import numpy as np
import numpy.typing as npt

class FixedPointLif(Protocol):
    """Expose fixed-point samples and the native named state dictionary."""

    def step(self, leak_k: int, gain_k: int, i_t: int, noise_in: int = 0) -> tuple[int, int]: ...
    def reset(self) -> None: ...
    def get_state(self) -> dict[str, int]: ...

class SurrogateLif(Protocol):
    """Expose the native differentiable neuron's samples and trace operations."""

    def forward(self, leak_k: int, gain_k: int, i_t: int, noise_in: int = 0) -> tuple[int, int]: ...
    def backward(self, grad_output: float) -> float: ...
    def clear_trace(self) -> None: ...
    def reset(self) -> None: ...
    def trace_len(self) -> int: ...

class BitStreamTensor(Protocol):
    """Expose packed hypervectors with integer counts and floating distances."""

    @property
    def length(self) -> int: ...
    @property
    def data(self) -> list[int]: ...
    def xor(self, other: BitStreamTensor) -> BitStreamTensor: ...
    def rotate_right(self, shift: int) -> None: ...
    def hamming_distance(self, other: BitStreamTensor) -> float: ...
    def popcount(self) -> int: ...

class DenseLayer(Protocol):
    """Expose native probability lists and float64 NumPy output buffers."""

    def get_weights(self) -> list[list[float]]: ...
    def set_weights(self, weights: Sequence[Sequence[float]]) -> None: ...
    def refresh_packed_weights(self) -> None: ...
    def forward(
        self, input_values: Sequence[float] | npt.NDArray[np.float64], seed: int = 44257
    ) -> list[float]: ...
    def forward_fast(self, input_values: Sequence[float], seed: int = 44257) -> list[float]: ...
    def forward_prepacked(self, packed_inputs: npt.NDArray[np.uint64]) -> list[float]: ...
    def forward_prepacked_numpy(
        self, packed_inputs: npt.NDArray[np.uint64]
    ) -> npt.NDArray[np.float64]: ...
    def forward_numpy(
        self, input_values: npt.NDArray[np.float64], seed: int = 44257
    ) -> npt.NDArray[np.float64]: ...
    def forward_batch_numpy(
        self, input_values: npt.NDArray[np.float64], seed: int = 44257
    ) -> npt.NDArray[np.float64]: ...

class StochasticGraphLayer(Protocol):
    """Expose native graph aggregation results before facade array reshaping."""

    def get_weights(self) -> list[float]: ...
    def is_sparse(self) -> bool: ...
    def forward(self, node_features: npt.NDArray[np.float64]) -> list[list[float]]: ...
    def forward_sc(
        self, node_features: npt.NDArray[np.float64], length: int = 1024, seed: int = 44257
    ) -> list[list[float]]: ...
