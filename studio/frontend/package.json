{
  "name": "sc-neurocore-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test && npm run test:federation",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:export": "npm run build && playwright test --config playwright.export.config.ts",
    "test:e2e:graph": "npm run build && playwright test --config playwright.graph.config.ts",
    "test:federation": "npm run build && playwright test --config playwright.federation.config.ts",
    "build": "tsc -b && vite build && npm run verify:federation",
    "verify:federation": "node scripts/verify-federation-build.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "12.11.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "dompurify": "3.4.15",
    "nanoid": "3.3.19",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@module-federation/runtime": "2.9.0",
    "@module-federation/vite": "1.22.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-jsdoc": "64.5.4",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
