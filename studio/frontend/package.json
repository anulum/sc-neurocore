{
  "name": "sc-neurocore-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "test": "vitest run && npm run test:build",
    "test:e2e": "playwright test && npm run test:federation",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:export": "npm run build && playwright test --config playwright.export.config.ts",
    "test:e2e:graph": "npm run build && playwright test --config playwright.graph.config.ts",
    "test:federation": "npm run build && playwright test --config playwright.federation.config.ts",
    "build": "tsc -b && vite build && node scripts/normalize-federation-types.ts dist/@mf-types.zip && npm run verify:federation",
    "verify:federation": "node scripts/verify-federation-build.mjs",
    "preview": "vite preview",
    "test:build": "node --test --experimental-test-coverage --test-coverage-include=**/scripts/normalize-federation-types.ts --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 scripts/normalize-federation-types.node-test.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.16"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "dompurify": "3.4.17",
    "nanoid": "3.3.20",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@module-federation/runtime": "2.9.2",
    "@module-federation/vite": "1.23.6",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "adm-zip": "0.6.1",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
