# SC-NeuroCore — Pollable top-level completion state

[tasks]
bmc
cover

[options]
bmc: mode bmc
cover: mode cover
depth 20

[engines]
smtbmc --unroll z3

[script]
exec -expect-return 0 -- sv2v --define=FORMAL --exclude=Assert --write=frontend.v sc_neurocore_top.v sc_axil_cfg.v sc_dense_layer_core.v sc_bitstream_encoder.v sc_bitstream_synapse.v sc_dotproduct_to_current.v sc_lif_neuron.v sc_firing_rate_bank.v
read -formal frontend.v
prep -top sc_neurocore_top

[files]
../sc_neurocore_top.v
../sc_axil_cfg.v
../sc_dense_layer_core.v
../sc_bitstream_encoder.v
../sc_bitstream_synapse.v
../sc_dotproduct_to_current.v
../sc_lif_neuron.v
../sc_firing_rate_bank.v
