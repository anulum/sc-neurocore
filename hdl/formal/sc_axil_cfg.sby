# SC-NeuroCore — AXI-Lite configuration proof

[options]
mode bmc
depth 20

[engines]
smtbmc

[script]
exec -expect-return 0 -- sv2v --define=FORMAL --exclude=Assert --write=frontend.v sc_axil_cfg_formal.v sc_axil_cfg.v
read -formal frontend.v
prep -top sc_axil_cfg_formal

[files]
sc_axil_cfg_formal.v
../sc_axil_cfg.v
