# SymbiYosys job for catalogue model sc_resetting_wilson_hr
# Retained SC project model formal (BMC)

[options]
mode bmc
depth 4

[engines]
smtbmc z3

[script]
read -formal sc_resetting_wilson_hr_formal.v
read -formal sc_resetting_wilson_hr.v
prep -top sc_resetting_wilson_hr_formal

[files]
sc_resetting_wilson_hr_formal.v
sc_resetting_wilson_hr.v
