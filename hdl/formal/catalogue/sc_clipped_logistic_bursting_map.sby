# SymbiYosys job for catalogue model sc_clipped_logistic_bursting_map
# Dual-axis perfect model formal (BMC)

[options]
mode bmc
depth 4

[engines]
smtbmc z3

[script]
read -formal sc_clipped_logistic_bursting_map_formal.v
read -formal sc_clipped_logistic_bursting_map.v
prep -top sc_clipped_logistic_bursting_map_formal

[files]
sc_clipped_logistic_bursting_map_formal.v
sc_clipped_logistic_bursting_map.v
