# SymbiYosys job for retained project model sc_four_state_glif
# Dual-axis perfect model formal (BMC)

[options]
mode bmc
depth 6

[engines]
smtbmc z3

[script]
read -formal sc_four_state_glif_formal.v
read -formal sc_four_state_glif.v
prep -top sc_four_state_glif_formal

[files]
sc_four_state_glif_formal.v
sc_four_state_glif.v
