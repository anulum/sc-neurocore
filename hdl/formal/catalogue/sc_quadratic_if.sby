# SymbiYosys job for catalogue model sc_quadratic_if
# Dual-axis perfect model formal (BMC)

[options]
mode bmc
depth 20

[engines]
smtbmc z3

[script]
read -formal sc_quadratic_if_formal.v
read -formal sc_quadratic_if.v
prep -top sc_quadratic_if_formal

[files]
sc_quadratic_if_formal.v
sc_quadratic_if.v
