# SymbiYosys job for catalogue model sc_upward_crossing_rulkov_map
# Retained SC project model formal (BMC)

[options]
mode bmc
depth 4

[engines]
smtbmc z3

[script]
read -formal sc_upward_crossing_rulkov_map_formal.v
read -formal sc_upward_crossing_rulkov_map.v
prep -top sc_upward_crossing_rulkov_map_formal

[files]
sc_upward_crossing_rulkov_map_formal.v
sc_upward_crossing_rulkov_map.v
