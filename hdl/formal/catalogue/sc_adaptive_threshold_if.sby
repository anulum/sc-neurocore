# SymbiYosys job for catalogue model sc_adaptive_threshold_if
# Dual-axis perfect model formal (BMC)

[options]
mode bmc
depth 4

[engines]
smtbmc z3

[script]
read -formal sc_adaptive_threshold_if_formal.v
read -formal sc_adaptive_threshold_if.v
prep -top sc_adaptive_threshold_if_formal

[files]
sc_adaptive_threshold_if_formal.v
sc_adaptive_threshold_if.v
