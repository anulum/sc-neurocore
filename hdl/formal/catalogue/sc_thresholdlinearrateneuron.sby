# SymbiYosys job for catalogue model sc_thresholdlinearrateneuron
# Dual-axis perfect model formal (BMC)

[options]
mode bmc
depth 4

[engines]
smtbmc z3

[script]
read -formal sc_thresholdlinearrateneuron_formal.v
read -formal sc_thresholdlinearrateneuron.v
prep -top sc_thresholdlinearrateneuron_formal

[files]
sc_thresholdlinearrateneuron_formal.v
sc_thresholdlinearrateneuron.v
