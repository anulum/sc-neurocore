# SymbiYosys job for catalogue model sc_connor_stevens
# Dual-axis perfect model formal (BMC)

[options]
mode bmc
depth 4

[engines]
smtbmc z3

[script]
read -formal sc_connor_stevens_formal.v
read -formal sc_connor_stevens.v
prep -top sc_connor_stevens_formal

[files]
sc_connor_stevens_formal.v
sc_connor_stevens.v
