# SymbiYosys job for the Teeter 2018 GLIF5 default-profile RTL
# Bounded reset, refractory and event-reset safety; not equation equivalence.

[options]
mode bmc
depth 6

[engines]
smtbmc z3

[script]
read -formal sc_glif_formal.v
read -formal sc_glif.v
prep -top sc_glif_formal

[files]
sc_glif_formal.v
sc_glif.v
