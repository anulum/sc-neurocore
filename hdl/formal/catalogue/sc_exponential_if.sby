# SymbiYosys job for catalogue model sc_exponential_if
# Dual-axis perfect model formal (BMC)

[options]
mode bmc
depth 4

[engines]
smtbmc z3

[script]
read -formal sc_exponential_if_formal.v
read -formal sc_exponential_if.v
prep -top sc_exponential_if_formal

[files]
sc_exponential_if_formal.v
sc_exponential_if.v
