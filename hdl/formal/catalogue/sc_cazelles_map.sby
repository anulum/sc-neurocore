# SymbiYosys job for catalogue model sc_cazelles_map
# Dual-axis perfect model formal (BMC)

[options]
mode bmc
depth 4

[engines]
smtbmc z3

[script]
read -formal sc_cazelles_map_formal.v
read -formal sc_cazelles_map.v
prep -top sc_cazelles_map_formal

[files]
sc_cazelles_map_formal.v
sc_cazelles_map.v
