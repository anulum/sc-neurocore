// SC-NeuroCore — Frozen 1P SRAM macro shape lookup functions (SHAPE 0..19)
//
// Generated by the group's earlier design study generator; imported as a frozen reference.
function integer sc_shape_words(input integer s);
    begin
        case (s)
        0: sc_shape_words = 64;
        1: sc_shape_words = 64;
        2: sc_shape_words = 256;
        3: sc_shape_words = 256;
        4: sc_shape_words = 256;
        5: sc_shape_words = 256;
        6: sc_shape_words = 256;
        7: sc_shape_words = 512;
        8: sc_shape_words = 512;
        9: sc_shape_words = 512;
        10: sc_shape_words = 512;
        11: sc_shape_words = 1024;
        12: sc_shape_words = 1024;
        13: sc_shape_words = 1024;
        14: sc_shape_words = 1024;
        15: sc_shape_words = 2048;
        16: sc_shape_words = 2048;
        17: sc_shape_words = 4096;
        18: sc_shape_words = 4096;
        19: sc_shape_words = 8192;
        default: sc_shape_words = 0;
        endcase
    end
endfunction
function integer sc_shape_bits(input integer s);
    begin
        case (s)
        0: sc_shape_bits = 16;
        1: sc_shape_bits = 64;
        2: sc_shape_bits = 8;
        3: sc_shape_bits = 16;
        4: sc_shape_bits = 32;
        5: sc_shape_bits = 48;
        6: sc_shape_bits = 64;
        7: sc_shape_bits = 8;
        8: sc_shape_bits = 16;
        9: sc_shape_bits = 32;
        10: sc_shape_bits = 64;
        11: sc_shape_bits = 8;
        12: sc_shape_bits = 16;
        13: sc_shape_bits = 32;
        14: sc_shape_bits = 64;
        15: sc_shape_bits = 32;
        16: sc_shape_bits = 64;
        17: sc_shape_bits = 8;
        18: sc_shape_bits = 16;
        19: sc_shape_bits = 32;
        default: sc_shape_bits = 0;
        endcase
    end
endfunction
