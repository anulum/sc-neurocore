  "schema_version": "sc-neurocore.benchmark-regression-gates.v1",
  "gates": [
    {
      "id": "formal-proof-elaboration",
      "artefact": "benchmarks/results/bench_formal.json",
      "required_numbers": [
        "lean_check_cold_wall_s",
        "lean_check_warm_wall_s",
        "n_theorems_proved",
        "n_axioms_explicit"
      ],
      "expected_values": {
        "cold_exit_code": 0,
        "warm_exit_code": 0
      }
    },
    {
      "id": "online-o1-adaptation",
      "artefact": "benchmarks/results/online_o1_adaptation_benchmark.json",
      "required_numbers": [
        "python.final_weight",
        "python.steps_to_target",
        "rust.final_weight",
        "rust.steps_to_target",
        "resource_estimate.per_synapse_state_bits",
        "resource_estimate.total_state_bits",
        "resource_estimate.max_update_latency_cycles"
      ],
      "expected_values": {
        "hardware_measurement_claimed": false,
        "parity.rust_matches_python": true
      }
    },
    {
      "id": "stochastic-backpropagation",
      "artefact": "benchmarks/results/stochastic_backprop_benchmark.json",
      "required_numbers": [
        "loss.initial",
        "loss.final",
        "loss.best",
        "estimator_variance.estimators.pathwise_relaxation.variance",
        "estimator_variance.estimators.score_function.variance",
        "estimator_variance.estimators.straight_through.variance",
        "stream_evidence.sampled_product_mae",
        "objective_terms.total"
      ],
      "expected_values": {
        "hardware_measurement_claimed": false,
        "joint_design.enabled": true
      }
    },
    {
      "id": "live-control-update-trap-evidence",
      "artefact": "benchmarks/results/local_python_2026-06-04_live_control_updates.json",
      "required_numbers": [
        "iterations",
        "repeats",
        "valid_update_write_count",
        "live_update_sequence_median_ns",
        "static_regeneration_median_ns",
        "trap_capture.compile_ns",
        "trap_capture.simulation_ns"
      ],
      "expected_values": {
        "benchmark": "live_control_update_and_trap_evidence",
        "language": "Python+SystemVerilog",
        "trap_bits.staged_overflow": 1,
        "trap_bits.staged_underflow": 2,
        "trap_capture.passed": true
      }
    },
    {
      "id": "aer-priority-backpressure-contract",
      "artefact": "benchmarks/results/local_python_2026-06-04_aer_priority_queue.json",
      "required_numbers": [
        "events",
        "repeats",
        "median_ns_per_event",
        "priority_violations",
        "fifo_tie_violations",
        "backpressure_rejections",
        "deadline_traps",
        "yosys.elapsed_ns"
      ],
      "expected_values": {
        "benchmark": "aer_priority_queue_backpressure_contract",
        "language": "Python+SystemVerilog",
        "benchmark_isolation_mode": "runtime-cpuset-shield",
        "hardware_measurement_claimed": false,
        "priority_violations": 0,
        "fifo_tie_violations": 0,
        "host_context.cgroup_effective_cpuset": "10-11",
        "host_context.runtime_cpuset_shield_claimed": true,
        "yosys.exit_code": 0
      }
    }
  ]
}
