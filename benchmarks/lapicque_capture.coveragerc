# SC-NeuroCore — Complete Lapicque capture statement and branch gate

[run]
branch = True
parallel = True
patch =
    subprocess
    _exit
include =
    */benchmarks/capture_lapicque_samples.py

[report]
show_missing = True
fail_under = 100
exclude_lines =
