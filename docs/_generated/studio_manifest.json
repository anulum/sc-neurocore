    "cross_repo": [
      {
        "adapter": "accel.get_backend().sc_forward",
        "sibling": "SCPN-CONTROL",
        "wire_format": "sc_forward"
      },
      {
        "adapter": "nir_bridge",
        "sibling": "NIR ecosystem (Norse/snnTorch/SpikingJelly/Sinabs/Rockpool)",
        "wire_format": "nir"
      },
      {
        "adapter": "hdl/pynq/sc_shd_driver.py",
        "sibling": "FPGA host (PYNQ-Z2)",
        "wire_format": "hil-telemetry"
      }
    ],
    "interfaces": [
      {
        "entry": "sc-neurocore = sc_neurocore.cli:main",
        "kind": "cli"
      },
      {
        "entry": "import sc_neurocore (lazy PEP 562 public API)",
        "kind": "library"
      },
      {
        "entry": "sc_neurocore.studio (FastAPI; ~113 /api endpoints)",
        "kind": "rest"
      }
    ],
    "pipeline_stages": [
      {
        "inputs": [
          "float values"
        ],
        "outputs": [
          "bitstream (uint8 0/1 or packed uint64)"
        ],
        "processing_model": "LFSR (x^16+x^14+x^13+x^11+1) or Sobol/Halton quasi-random encoding",
        "stage": "encode"
      },
      {
        "inputs": [
          "bitstreams",
          "fixed-point weights (Q8.8)"
        ],
        "outputs": [
          "spikes",
          "membrane voltages"
        ],
        "processing_model": "multiply = AND (unipolar) / XNOR (bipolar [-1,1]); scaled-add = MUX; fixed-point LIF neurons; packed AND + popcount",
        "stage": "sc-primitives"
      },
      {
        "inputs": [
          "populations",
          "CSR projections",
          "stimuli"
        ],
        "outputs": [
          "spike trains",
          "voltages",
