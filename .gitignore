obj_dir/
cosim/obj_dir/

# Benchmark artifacts (Criterion working dirs)
.benchmarks/

# Compiled Go benchmark binaries (regenerate via `go test -bench -c`)
src/sc_neurocore/accel/go/services/**/services_bench
# Compiled Go-service executables built by `hil_server.py` on first
# `.start(build=True)` / by the `aer_router` daemon at runtime. Source
# (*.go, go.mod, go.sum) stays tracked; the compiled output does not.
src/sc_neurocore/accel/go/services/*/hil_debugger
src/sc_neurocore/accel/go/services/*/aer_router
src/sc_neurocore/accel/go/services/**/services_ext_bench
src/sc_neurocore/accel/go/services/**/*_bench
src/sc_neurocore/accel/go/evo_substrate/evo_substrate_bench

# Ad-hoc fix scripts
auto_fix*.py
fix_*.py
full_test_report.txt
.hypothesis/

# Bridge build artifacts (platform-specific .pyd/.so)
*.pyd
*.so
!engine/src/**/*.rs

# Studio frontend build artifacts
studio/frontend/node_modules/
studio/frontend/dist/
studio/frontend/playwright-report/
studio/frontend/test-results/
studio/frontend/tsconfig.tsbuildinfo

# MkDocs build output
site/

# Downloaded datasets
data/

# Experimental / speculative code (AI-generated, not production)
experimental/
# ...except the packaged `alternative_path` harness which ships as a
# real opt-in module under sc_neurocore.experimental. The unignore
# below is explicitly scoped to tracked file types so Python cache
# directories do not slip back in via the reverse-ignore.
!src/sc_neurocore/experimental/
!src/sc_neurocore/experimental/*.py
!src/sc_neurocore/experimental/*.md

# Test / demo output artefacts that get regenerated by CI or by the
# demo scripts; no reason to carry binary churn in git history.
stdp_learning_result.png
test_points.json

# Timestamped suite-runner output under benchmarks/results/; the
# summary JSON files at the top of benchmarks/results/ are the
# reference reports, the dated subdirectories are per-invocation
# artefacts regenerated every time tools/run_experimental_suite.py
# runs.
benchmarks/results/experimental_runs/

# Hardware tests (PYNQ board-specific, not part of CI)
hardware_tests/

# local assistant config — never commit
CLAUDE.md
.claude/

# Local backups and archives are never committed. Keep historical TODO
# snapshots, generated scaffolds, retired experiments, and provenance dumps in
# these directories rather than in tracked docs.
BACKUP/
ARCHIVE/
archive/
archives/

# AutoResearch sandbox — local working copies, never committed
.autoresearch-gemini/

# Vivado
vivado.jou
vivado.log
vivado*.backup.*

# Internal coordination (incidents, sessions)
.coordination/

# Internal local automation
docs/internal/gemini/

# Agent metadata (per `feedback_agent_metadata_gitignore`)
.agent_metadata.json

# Per-run network export artifacts (left by interactive scripts)
network_schema.json
network_schema.json_layer_*_weights.npy

# Generated waveform dumps from Verilog testbenches
tb_sc_*.vcd

# IBM/Aer verification run outputs are runtime provenance artifacts.
# Curated baselines should live under tests/fixtures with explicit metadata.
results/ibm_verification/*.json

# ORCA/Vertex chemistry run outputs. Acquisition inputs, scripts, manifests,
# and README/YAML provenance stay tracked explicitly; generated scratch/output
# artifacts are regenerated or pulled from GCS.
results/posner_external_data/orca/*.bas*
results/posner_external_data/orca/*.carthess
results/posner_external_data/orca/*.densities*
results/posner_external_data/orca/*.gbw
results/posner_external_data/orca/*.hostnames
results/posner_external_data/orca/*.opt
results/posner_external_data/orca/*.out
results/posner_external_data/orca/*.pid
results/posner_external_data/orca/*.property.txt
results/posner_external_data/orca/*.tmp.*
results/posner_external_data/orca/*.xyz
results/posner_external_data/orca/orca_env.sh
results/posner_external_data/vertex/**/input_from_local_cycle_snapshot.xyz
results/posner_external_data/vertex/**/output*/
# ML350 research-lane raw ORCA outputs. The curated provenance record (extracted
# JSON parameters, manifests, inputs, run scripts, READMEs, SHA256SUMS, evidence
# notes) stays tracked; raw .out/.xyz outputs live on ML350 under
# /mnt/data_sas/sc-neurocore-orca-runs/ and are verifiable via SHA256SUMS.
results/posner_external_data/ml350/**/*.out
results/posner_external_data/ml350/**/*.xyz

# Local downloads from Vertex/GCS jobs. Keep curated summaries or fixtures in
# tracked docs/results paths; raw job payloads, checkpoints, and archives do not
# belong on main.
results/vertex/

# Stale lowercase-name symlink to this repo root (deleted on cleanup)
sc-neurocore

# Z3 solver trace artefacts (debug output, regenerable, not source)
.z3-trace

# Community benchmark contributions (runtime data, not source)
benchmarks/databank/

# Source papers — COPYRIGHT SAFETY. Full publisher PDFs are kept locally for
# reference under docs/source_papers/pdfs/ but MUST NOT be committed. Only our
# own transcribed parameter tables + the SOURCES.md index (facts, attributed)
# are tracked. Belt-and-suspenders: any PDF anywhere under source_papers is
# ignored, plus the legacy external_papers location.
docs/source_papers/pdfs/
docs/source_papers/**/*.pdf
docs/external_papers/
