    var _run_demo_line = 'band_powers=evs._baseline_powers,'
    var _run_demo_line = ')'
    var _run_demo_line = 'print("\\n  Profile after session:")'
    var _run_demo_line = 'print("    Sessions:       %d" % profile.session_count)'
    var _run_demo_line = 'print("    Target Hz:      %.2f" % profile.get_best_target_h'
    var _run_demo_line = 'print("    Chronotype:     %s" % profile.chronotype.value)'
    var _run_demo_line = 'print("\\n" + "=" * 72)'
    var _run_demo_line = 'print("  Demo complete.")'
    var _run_demo_line = 'print("=" * 72)'
    return 0
