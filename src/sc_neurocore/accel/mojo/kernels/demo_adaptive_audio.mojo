fn _generate_eeg_chunk(rng: Int, n_samples: Int, target_hz: Int, sample_rate: Int, entrained_strength: Int, noise_level: Int) -> Int:
    var __generate_eeg_chunk_line = 'rng: random.RandomState,'
    var __generate_eeg_chunk_line = 'n_samples: int,'
    var __generate_eeg_chunk_line = 'target_hz: float,'
    var __generate_eeg_chunk_line = 'sample_rate: int,'
    var __generate_eeg_chunk_line = 'entrained_strength: float = 0.5,'
    var __generate_eeg_chunk_line = 'noise_level: float = 0.3,'
    var __generate_eeg_chunk_line = ') -> ndarray[Any, Any]:'
    var __generate_eeg_chunk_line = 't = arange(n_samples) / sample_rate'
    var __generate_eeg_chunk_line = '# Target sinusoid'
    var __generate_eeg_chunk_line = 'signal = entrained_strength * sin(2 * pi * target_hz * t)'
    var __generate_eeg_chunk_line = '# Background: mix of brain bands'
    var __generate_eeg_chunk_line = 'signal += 0.15 * sin(2 * pi * 2.5 * t)  # delta'
    var __generate_eeg_chunk_line = 'signal += 0.10 * sin(2 * pi * 6.0 * t)  # theta'
    var __generate_eeg_chunk_line = 'signal += 0.08 * sin(2 * pi * 20.0 * t)  # beta'
    var __generate_eeg_chunk_line = '# Noise'
    var __generate_eeg_chunk_line = 'signal += noise_level * rng.randn(n_samples)'
    return 0  # return signal

fn run_demo() -> Int:
    var _run_demo_line = 'rng = random.RandomState(42)'
    var _run_demo_line = '# ── 1. Create components ──────────────────────────────────'
