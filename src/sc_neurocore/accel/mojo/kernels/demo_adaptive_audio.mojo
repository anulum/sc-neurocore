    var _run_demo_line = 'for v in baseline_eeg:'
    var _run_demo_line = 'evs.add_sample(float(v))'
    var _run_demo_line = 'print("  Baseline done: %s" % ({k: "%.4f" % v for k, v in ev'
    var _run_demo_line = 'evs.set_target(target_hz)'
    var _run_demo_line = '# ── 3. Run 50 adaptive ticks ──────────────────────────────'
    var _run_demo_line = 'print('
    var _run_demo_line = '"\\n  %s  %s  %s  %s  %s  %s  %s"'
    var _run_demo_line = '% ('
    var _run_demo_line = '"Tick".rjust(6),'
