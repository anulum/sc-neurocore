    var _run_demo_line = 'target_hz = profile.get_best_target_hz()'
    var _run_demo_line = '# ── 2. Baseline ───────────────────────────────────────────'
    var _run_demo_line = 'print("=" * 72)'
    var _run_demo_line = 'print("  SSGF Adaptive Audio Demo")'
    var _run_demo_line = 'print("  Chronotype: BEAR | Target: %.1f Hz (alpha)" % targe'
    var _run_demo_line = 'print("=" * 72)'
    var _run_demo_line = 'print("\\n  Recording baseline...")'
    var _run_demo_line = 'evs.start_baseline()'
    var _run_demo_line = 'baseline_samples = int(evs_cfg.baseline_duration_s * evs_cfg'
    var _run_demo_line = 'baseline_eeg = _generate_eeg_chunk('
