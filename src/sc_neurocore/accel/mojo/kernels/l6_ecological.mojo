fn step(dt: Int, l5_input: Int, solar_activity: Int, lunar_phase: Int) -> Int:
    var _step_line = 'self,'
    var _step_line = 'dt: float,'
    var _step_line = 'l5_input: Optional[Dict[str, Any]] = 0,'
    var _step_line = 'solar_activity: float = 0.5,'
    var _step_line = 'lunar_phase: float = 0.0,'
    var _step_line = ') -> Dict[str, Any]:'
    var _step_line = 'time += dt'
    var _step_line = '# 1. Schumann resonance dynamics'
    var _step_line = 'for i, freq in enumerate(params.schumann_frequencies):'
    var _step_line = 'schumann_phases[i] += 2 * pi * freq * dt'
    var _step_line = 'schumann_phases[i] = schumann_phases[i] % (2 * pi)'
    var _step_line = '# Compute Schumann field as superposition'
    var _step_line = 'schumann_signal = zeros(params.n_field_nodes)'
    var _step_line = 'for i, freq in enumerate(params.schumann_frequencies):'
    var _step_line = 'spatial_pattern = sin(linspace(0, 2 * pi * (i + 1), params.n'
    var _step_line = 'schumann_signal += ('
    var _step_line = 'schumann_amplitudes[i]'
    var _step_line = '* params.schumann_amplitude'
    var _step_line = '* cos(schumann_phases[i])'
    var _step_line = '* spatial_pattern'
    var _step_line = ')'
    var _step_line = '# Add noise'
    var _step_line = 'schumann_signal += params.schumann_noise * random.normal('
    var _step_line = '0, 1, params.n_field_nodes'
    var _step_line = ')'
    var _step_line = '# Normalize to [0, 1]'
    var _step_line = 'schumann_field = (schumann_signal - schumann_signal.min()) /'
    var _step_line = 'schumann_signal.max() - schumann_signal.min() + 1e-8'
    var _step_line = ')'
    var _step_line = '# 2. Geomagnetic field dynamics'
    var _step_line = '# Solar activity modulates geomagnetic storms'
    var _step_line = 'storm_factor = 1.0 + 0.5 * (solar_activity - 0.5)'
    var _step_line = 'geomag_variation = ('
    var _step_line = 'params.geomag_variation'
    var _step_line = '* storm_factor'
    var _step_line = '* random.normal(0, 1, params.n_field_nodes)'
    var _step_line = ')'
    var _step_line = 'geomag_field = clip('
    var _step_line = 'geomag_field + geomag_variation * dt,'
    var _step_line = 'params.geomag_baseline * 0.5,'
    var _step_line = 'params.geomag_baseline * 1.5,'
    var _step_line = ')'
    var _step_line = '# 3. Circadian rhythm'
    var _step_line = 'circadian_phase += 2 * pi * dt / params.circadian_period'
    var _step_line = 'circadian_phase = circadian_phase % (2 * pi)'
    var _step_line = 'circadian_signal = 0.5 + params.circadian_amplitude * cos(ci'
    var _step_line = '# 4. Biospheric network dynamics'
    var _step_line = '# Coupling between nodes'
    var _step_line = 'network_coupling = zeros(params.n_field_nodes)'
    var _step_line = 'for i in range(params.n_field_nodes):'
    var _step_line = 'neighbors = [(i - 1) % params.n_field_nodes, (i + 1) % param'
    var _step_line = 'neighbor_mean = mean([biospheric_field[j] for j in neighbors'
    var _step_line = 'network_coupling[i] = neighbor_mean - biospheric_field[i]'
    var _step_line = 'biospheric_field += ('
    var _step_line = 'params.network_coupling * network_coupling'
    var _step_line = '+ params.network_noise * random.normal(0, 1, params.n_field_'
    var _step_line = ') * dt'
    var _step_line = '# Modulate by Schumann and circadian'
    var _step_line = 'biospheric_field *= (0.9 + 0.1 * schumann_field) * (0.8 + 0.'
    var _step_line = 'biospheric_field = clip(biospheric_field, 0.0, 1.0)'
    var _step_line = '# 5. Organismal coupling (L5 collective emotional state affe'
    var _step_line = 'if l5_input is not 0:'
    var _step_line = 'if "emotional_state" in l5_input:'
    var _step_line = 'emotional_coherence = mean(l5_input["emotional_state"])'
    var _step_line = 'biospheric_field += ('
    var _step_line = 'params.organismal_coupling * (emotional_coherence - 0.5) * d'
    var _step_line = ')'
    var _step_line = 'biospheric_field = clip(biospheric_field, 0.0, 1.0)'
    var _step_line = '# 6. Lunar phase modulation'
    var _step_line = 'lunar_factor = 0.5 + 0.5 * cos(lunar_phase)'
    var _step_line = 'schumann_amplitudes = ones(len(params.schumann_frequencies))'
    var _step_line = '0.8 + 0.2 * lunar_factor'
    var _step_line = ')'
    var _step_line = '# 7. Compute planetary coherence'
    var _step_line = 'planetary_coherence = float('
    var _step_line = 'abs(mean(exp(1j * 2 * pi * biospheric_field)))'
    var _step_line = ')'
    var _step_line = '# 8. Generate output bitstreams'
    var _step_line = 'output_probs = biospheric_field * circadian_signal'
    var _step_line = 'rands = random.random((params.n_field_nodes, params.bitstrea'
    var _step_line = 'output_bitstreams = (rands < output_probs[:, 0]).astype(uint'
    var _step_line = '# Store history'
    var _step_line = 'result = {'
    var _step_line = '"schumann_field": schumann_field,'
    var _step_line = '"schumann_phases": schumann_phases.copy(),'
    var _step_line = '"geomag_field": geomag_field.copy(),'
    var _step_line = '"circadian_phase": circadian_phase,'
    var _step_line = '"circadian_signal": circadian_signal,'
    var _step_line = '"biospheric_field": biospheric_field.copy(),'
    var _step_line = '"planetary_coherence": planetary_coherence,'
    var _step_line = '"output_bitstreams": output_bitstreams,'
    var _step_line = '}'
    var _step_line = 'history.append('
    var _step_line = '{'
    var _step_line = '"time": time,'
    var _step_line = '"coherence": planetary_coherence,'
    var _step_line = '"schumann_power": float(mean(schumann_field**2)),'
    var _step_line = '}'
    var _step_line = ')'
    var _step_line = 'if len(history) > 100:'
    var _step_line = 'history.pop(0)'
    return 0  # return result

