    var __xor_and_recover_lfsr_line = 'predicted = (lfsr_regs < rates_q8).astype(int8)'
    var __xor_and_recover_lfsr_line = 'for ch in range(N):'
    var __xor_and_recover_lfsr_line = 'lfsr_regs[ch] = _lfsr16_step(int(lfsr_regs[ch]))'
    var __xor_and_recover_lfsr_line = 'row = errors[t] ^ predicted'
    var __xor_and_recover_lfsr_line = 'spikes[t] = row'
    var __xor_and_recover_lfsr_line = 'for ch in range(N):'
    var __xor_and_recover_lfsr_line = 'target = 255 if row[ch] else 0'
    var __xor_and_recover_lfsr_line = 'rates_q8[ch] += (alpha_q8 * (target - rates_q8[ch])) >> 8'
    var __xor_and_recover_lfsr_line = 'rates_q8[ch] = max(0, min(255, rates_q8[ch]))'
    return 0  # return spikes

