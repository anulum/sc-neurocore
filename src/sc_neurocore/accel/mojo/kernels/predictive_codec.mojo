fn _predict_and_xor_context(spikes: Int, N: Int, context_bits: Int) -> Int:
    var __predict_and_xor_context_line = 'spikes: ndarray, N: int, context_bits: int = 8'
    var __predict_and_xor_context_line = ') -> tuple[ndarray, int]:'
    var __predict_and_xor_context_line = 'T = spikes.shape[0]'
    var __predict_and_xor_context_line = 'errors = empty_like(spikes)'
    var __predict_and_xor_context_line = 'correct = 0'
    var __predict_and_xor_context_line = 'mask = (1 << context_bits) - 1'
    var __predict_and_xor_context_line = '# Per-channel: context register + prediction table'
    var __predict_and_xor_context_line = 'contexts = zeros(N, dtype=int64)'
    var __predict_and_xor_context_line = '# Tables: context_key → [n_spikes_after, n_total]'
    var __predict_and_xor_context_line = 'tables: list[dict[int, list[int]]] = [{} for _ in range(N)]'
    var __predict_and_xor_context_line = 'for t in range(T):'
    var __predict_and_xor_context_line = 'row = spikes[t]'
    var __predict_and_xor_context_line = 'for ch in range(N):'
    var __predict_and_xor_context_line = 'ctx = int(contexts[ch])'
    var __predict_and_xor_context_line = 'table = tables[ch]'
    var __predict_and_xor_context_line = '# Predict from context statistics'
    var __predict_and_xor_context_line = 'if ctx in table:'
    var __predict_and_xor_context_line = 'n_spike, n_total = table[ctx]'
    var __predict_and_xor_context_line = 'predicted = 1 if n_spike * 2 > n_total else 0'
    var __predict_and_xor_context_line = 'else:'
    var __predict_and_xor_context_line = 'predicted = 0'
    var __predict_and_xor_context_line = 'actual = int(row[ch])'
    var __predict_and_xor_context_line = 'err = actual ^ predicted'
    var __predict_and_xor_context_line = 'errors[t, ch] = err'
    var __predict_and_xor_context_line = 'if err == 0:'
    var __predict_and_xor_context_line = 'correct += 1'
    var __predict_and_xor_context_line = '# Update context table'
    var __predict_and_xor_context_line = 'if ctx not in table:'
    var __predict_and_xor_context_line = 'table[ctx] = [0, 0]'
    var __predict_and_xor_context_line = 'table[ctx][1] += 1'
    var __predict_and_xor_context_line = 'if actual:'
    var __predict_and_xor_context_line = 'table[ctx][0] += 1'
    var __predict_and_xor_context_line = '# Shift context register'
    var __predict_and_xor_context_line = 'contexts[ch] = ((contexts[ch] << 1) | actual) & mask'
    return 0  # return errors, correct

fn _xor_and_recover_context(errors: Int, N: Int, context_bits: Int) -> Int:
    var __xor_and_recover_context_line = 'T = errors.shape[0]'
    var __xor_and_recover_context_line = 'spikes = empty((T, N), dtype=int8)'
    var __xor_and_recover_context_line = 'mask = (1 << context_bits) - 1'
    var __xor_and_recover_context_line = 'contexts = zeros(N, dtype=int64)'
    var __xor_and_recover_context_line = 'tables: list[dict[int, list[int]]] = [{} for _ in range(N)]'
    var __xor_and_recover_context_line = 'for t in range(T):'
    var __xor_and_recover_context_line = 'for ch in range(N):'
    var __xor_and_recover_context_line = 'ctx = int(contexts[ch])'
    var __xor_and_recover_context_line = 'table = tables[ch]'
    var __xor_and_recover_context_line = 'if ctx in table:'
    var __xor_and_recover_context_line = 'n_spike, n_total = table[ctx]'
    var __xor_and_recover_context_line = 'predicted = 1 if n_spike * 2 > n_total else 0'
    var __xor_and_recover_context_line = 'else:'
    var __xor_and_recover_context_line = 'predicted = 0'
    var __xor_and_recover_context_line = 'actual = int(errors[t, ch]) ^ predicted'
    var __xor_and_recover_context_line = 'spikes[t, ch] = actual'
    var __xor_and_recover_context_line = 'if ctx not in table:'
    var __xor_and_recover_context_line = 'table[ctx] = [0, 0]'
    var __xor_and_recover_context_line = 'table[ctx][1] += 1'
    var __xor_and_recover_context_line = 'if actual:'
    var __xor_and_recover_context_line = 'table[ctx][0] += 1'
    var __xor_and_recover_context_line = 'contexts[ch] = ((contexts[ch] << 1) | actual) & mask'
    return 0  # return spikes

fn _predict_and_xor(spikes: Int, N: Int, alpha: Int, threshold: Int) -> Int:
    var __predict_and_xor_line = 'spikes: ndarray, N: int, alpha: float, threshold: float'
    var __predict_and_xor_line = ') -> tuple[ndarray, int]:'
    var __predict_and_xor_line = 'T = spikes.shape[0]'
    var __predict_and_xor_line = 'rates = zeros(N, dtype=float64)'
    var __predict_and_xor_line = 'errors = empty_like(spikes)'
    var __predict_and_xor_line = 'correct = 0'
    var __predict_and_xor_line = 'alpha_f = float(alpha)'
    var __predict_and_xor_line = 'one_minus_alpha = 1.0 - alpha_f'
    var __predict_and_xor_line = 'for t in range(T):'
    var __predict_and_xor_line = 'row = spikes[t]'
    var __predict_and_xor_line = 'predicted = (rates > threshold).view(int8)'
    var __predict_and_xor_line = 'errors[t] = row ^ predicted'
    var __predict_and_xor_line = 'correct += N - int(count_nonzero(errors[t]))'
    var __predict_and_xor_line = 'rates *= one_minus_alpha'
    var __predict_and_xor_line = 'rates += alpha_f * row'
    return 0  # return errors, correct

fn _xor_and_recover(errors: Int, N: Int, alpha: Int, threshold: Int) -> Int:
    var __xor_and_recover_line = 'T = errors.shape[0]'
    var __xor_and_recover_line = 'rates = zeros(N, dtype=float64)'
    var __xor_and_recover_line = 'spikes = empty((T, N), dtype=int8)'
    var __xor_and_recover_line = 'alpha_f = float(alpha)'
    var __xor_and_recover_line = 'one_minus_alpha = 1.0 - alpha_f'
    var __xor_and_recover_line = 'for t in range(T):'
    var __xor_and_recover_line = 'predicted = (rates > threshold).view(int8)'
    var __xor_and_recover_line = 'row = errors[t] ^ predicted'
    var __xor_and_recover_line = 'spikes[t] = row'
    var __xor_and_recover_line = 'rates *= one_minus_alpha'
    var __xor_and_recover_line = 'rates += alpha_f * row'
    return 0  # return spikes

fn _lfsr16_step(reg: Int) -> Int:
    var __lfsr16_step_line = 'feedback = ((reg >> 15) ^ (reg >> 13) ^ (reg >> 12) ^ (reg >'
    return 0  # return ((reg << 1) & _LFSR_MASK) | feedback

fn _predict_and_xor_lfsr(spikes: Int, N: Int, alpha_q8: Int, seed: Int) -> Int:
    var __predict_and_xor_lfsr_line = 'spikes: ndarray,'
    var __predict_and_xor_lfsr_line = 'N: int,'
    var __predict_and_xor_lfsr_line = 'alpha_q8: int,'
    var __predict_and_xor_lfsr_line = 'seed: int,'
    var __predict_and_xor_lfsr_line = ') -> tuple[ndarray, int]:'
    var __predict_and_xor_lfsr_line = 'T = spikes.shape[0]'
    var __predict_and_xor_lfsr_line = '# Per-channel Q8.8 rate estimates (0-255 maps to 0.0-~1.0)'
    var __predict_and_xor_lfsr_line = 'rates_q8 = zeros(N, dtype=int32)'
    var __predict_and_xor_lfsr_line = 'errors = empty_like(spikes)'
    var __predict_and_xor_lfsr_line = 'correct = 0'
    var __predict_and_xor_lfsr_line = '# Per-channel LFSR state (different seed per channel for dec'
    var __predict_and_xor_lfsr_line = 'lfsr_regs = array('
    var __predict_and_xor_lfsr_line = '[((seed + ch * 7919) & _LFSR_MASK) or 1 for ch in range(N)],'
    var __predict_and_xor_lfsr_line = 'dtype=int32,'
    var __predict_and_xor_lfsr_line = ')'
    var __predict_and_xor_lfsr_line = 'for t in range(T):'
    var __predict_and_xor_lfsr_line = 'row = spikes[t]'
    var __predict_and_xor_lfsr_line = '# Predict: LFSR < rate_q8 → predict spike (same as Verilog c'
    var __predict_and_xor_lfsr_line = 'predicted = (lfsr_regs < rates_q8).astype(int8)'
    var __predict_and_xor_lfsr_line = '# Step all LFSRs'
    var __predict_and_xor_lfsr_line = 'for ch in range(N):'
    var __predict_and_xor_lfsr_line = 'lfsr_regs[ch] = _lfsr16_step(int(lfsr_regs[ch]))'
    var __predict_and_xor_lfsr_line = '# XOR'
    var __predict_and_xor_lfsr_line = 'errors[t] = row ^ predicted'
    var __predict_and_xor_lfsr_line = 'correct += N - int(count_nonzero(errors[t]))'
    var __predict_and_xor_lfsr_line = '# Q8.8 EMA update: rate += alpha * (actual - rate) >> 8'
    var __predict_and_xor_lfsr_line = '# Equivalent: rate = rate + alpha * (actual*256 - rate) >> 8'
    var __predict_and_xor_lfsr_line = 'for ch in range(N):'
    var __predict_and_xor_lfsr_line = 'target = 255 if row[ch] else 0'
    var __predict_and_xor_lfsr_line = 'rates_q8[ch] += (alpha_q8 * (target - rates_q8[ch])) >> 8'
    var __predict_and_xor_lfsr_line = 'rates_q8[ch] = max(0, min(255, rates_q8[ch]))'
    return 0  # return errors, correct

fn _xor_and_recover_lfsr(errors: Int, N: Int, alpha_q8: Int, seed: Int) -> Int:
    var __xor_and_recover_lfsr_line = 'errors: ndarray,'
