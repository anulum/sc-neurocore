    var _compress_line = 'error_data, _ = base_codec.compress(errors)'
    var _compress_line = 'header = HEADER_MAGIC_LFSR + struct.pack("!HH", alpha_q8, se'
    var _compress_line = 'else:'
    var _compress_line = 'if _HAS_RUST:  # pragma: no cover'
    var _compress_line = 'flat = ascontiguousarray(spikes).ravel()'
    var _compress_line = 'err_flat, correct_predictions = _rust_predict_ema('
