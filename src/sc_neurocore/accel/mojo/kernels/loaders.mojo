    var _load_nmnist_line = 'seed: int = 42,'
    var _load_nmnist_line = ') -> tuple[list[ndarray], ndarray]:'
    var _load_nmnist_line = 'if synthetic:'
    return 0  # return _synthetic_event_dataset(
    var _load_nmnist_line = 'n_samples,'
    var _load_nmnist_line = '_NMNIST_RES,'
    var _load_nmnist_line = '10,'
    var _load_nmnist_line = 'T,'
    var _load_nmnist_line = 'dt_ms,'
    var _load_nmnist_line = 'seed,'
    var _load_nmnist_line = ')'
    var _load_nmnist_line = '_check_root(root, "N-MNIST", _NMNIST_URL)'
    var _load_nmnist_line = 'split_dir = Path(root) / ("Train" if train else "Test")'
    var _load_nmnist_line = 'if not split_dir.exists():'
    var _load_nmnist_line = 'raise FileNotFoundError('
    var _load_nmnist_line = 'f"Expected split directory {split_dir.resolve()}. Download f'
    var _load_nmnist_line = ')'
    var _load_nmnist_line = '# Real loader: N-MNIST uses .bin files, one per sample, grou'
    var _load_nmnist_line = 'samples: list[ndarray] = []'
    var _load_nmnist_line = 'label_list: list[int] = []'
    var _load_nmnist_line = 'for class_dir in sorted(split_dir.iterdir()):'
    var _load_nmnist_line = 'if not class_dir.is_dir():'
    var _load_nmnist_line = 'continue'
