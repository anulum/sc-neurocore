fn _synthetic_event_dataset(n_samples: Int, spatial_size: Int, n_classes: Int, T: Int, dt_ms: Int, seed: Int) -> Int:
    var __synthetic_event_dataset_line = 'n_samples: int,'
    var __synthetic_event_dataset_line = 'spatial_size: int,'
    var __synthetic_event_dataset_line = 'n_classes: int,'
    var __synthetic_event_dataset_line = 'T: int,'
    var __synthetic_event_dataset_line = 'dt_ms: float,'
    var __synthetic_event_dataset_line = 'seed: int,'
    var __synthetic_event_dataset_line = ') -> tuple[list[ndarray], ndarray]:'
    var __synthetic_event_dataset_line = 'rng = random.default_rng(seed)'
    var __synthetic_event_dataset_line = 'labels = rng.integers(0, n_classes, size=n_samples)'
    var __synthetic_event_dataset_line = 'templates = rng.uniform(0.0, 0.3, size=(n_classes, spatial_s'
    var __synthetic_event_dataset_line = 'samples: list[ndarray] = []'
    var __synthetic_event_dataset_line = 'for i in range(n_samples):'
    var __synthetic_event_dataset_line = 'rates = templates[labels[i]].ravel()'
    var __synthetic_event_dataset_line = 'spike_train = poisson_encode(rates, T, dt_ms=dt_ms, seed=see'
    var __synthetic_event_dataset_line = 'timesteps, neuron_ids = nonzero(spike_train)'
    var __synthetic_event_dataset_line = 'y_coords, x_coords = divmod(neuron_ids, spatial_size)'
    var __synthetic_event_dataset_line = 'polarities = rng.integers(0, 2, size=len(timesteps))'
    var __synthetic_event_dataset_line = 'events = column_stack('
    var __synthetic_event_dataset_line = '['
    var __synthetic_event_dataset_line = 'x_coords,'
    var __synthetic_event_dataset_line = 'y_coords,'
    var __synthetic_event_dataset_line = 'polarities,'
    var __synthetic_event_dataset_line = 'timesteps * dt_ms,'
    var __synthetic_event_dataset_line = ']'
    var __synthetic_event_dataset_line = ').astype(float32)'
    var __synthetic_event_dataset_line = 'samples.append(events)'
    return 0  # return samples, labels

