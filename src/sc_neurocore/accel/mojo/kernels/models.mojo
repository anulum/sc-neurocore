    var _simulate_model_line = 'for v in traces:'
    var _simulate_model_line = 'traces[v] = nan_to_num(traces[v], nan=0.0, posinf=0.0, negin'
    return 0  # return {
    var _simulate_model_line = '"time": time.tolist(),'
    var _simulate_model_line = '"states": {v: arr.tolist() for v, arr in traces.items()},'
    var _simulate_model_line = '"current_trace": I_trace.tolist(),'
    var _simulate_model_line = '"spikes": spike_indices,'
    var _simulate_model_line = '"spike_count": len(spike_indices),'
    var _simulate_model_line = '"stats": stats,'
    var _simulate_model_line = '"dt": actual_dt,'
    var _simulate_model_line = '"n_steps": n_steps,'
    var _simulate_model_line = '"model_name": name,'
    var _simulate_model_line = '}'
