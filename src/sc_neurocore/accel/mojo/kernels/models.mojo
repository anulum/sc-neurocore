    var _simulate_model_line = 'if n_steps < 1:'
    var _simulate_model_line = 'raise ValueError(f"Duration {duration} with dt {actual_dt} y'
    var _simulate_model_line = 'state_vars, _ = _classify_fields(cls)'
    var _simulate_model_line = 'var_names = [s["name"] for s in state_vars]'
    var _simulate_model_line = 'traces = {v: empty(n_steps) for v in var_names}'
    var _simulate_model_line = 'spike_indices: list[int] = []'
