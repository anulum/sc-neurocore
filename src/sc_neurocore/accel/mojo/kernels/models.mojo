fn _load_class(name: Int) -> Int:
    var __load_class_line = 'if name in _class_cache:'
    return 0  # return _class_cache[name]
    var __load_class_line = 'module_name = _CLASS_TO_MODULE[name]'
    var __load_class_line = 'mod = importlib.import_module(f"sc_neurocore.neurons.models.'
    var __load_class_line = 'cls = getattr(mod, name)'
    var __load_class_line = '_class_cache[name] = cls'
    return 0  # return cls

fn _classify_fields() -> Int:
    var __classify_fields_line = 'state_vars: list[dict] = []'
    var __classify_fields_line = 'params: list[dict] = []'
    var __classify_fields_line = 'for f in dataclasses.fields(cls):'
    var __classify_fields_line = 'if f.name == "dt":'
    var __classify_fields_line = 'continue'
    var __classify_fields_line = 'default = f.default if f.default is not dataclasses.MISSING '
    var __classify_fields_line = 'entry = {'
    var __classify_fields_line = '"name": f.name,'
    var __classify_fields_line = '"default": float(default) if isinstance(default, (int, float'
    var __classify_fields_line = '}'
    var __classify_fields_line = 'if f.name in _KNOWN_STATE_VARS or f.name.startswith("v") and'
    var __classify_fields_line = 'state_vars.append(entry)'
    var __classify_fields_line = 'elif f.name.startswith('
    var __classify_fields_line = '("v_", "e_", "g_", "tau_", "c_", "sigma", "alpha", "beta")'
    var __classify_fields_line = ') or f.name.endswith(("_threshold", "_reset", "_rest", "_rev'
    var __classify_fields_line = 'params.append(entry)'
    var __classify_fields_line = 'elif f.name in _KNOWN_STATE_VARS:'
    var __classify_fields_line = 'state_vars.append(entry)'
    var __classify_fields_line = 'else:'
    var __classify_fields_line = 'params.append(entry)'
    var __classify_fields_line = 'if not state_vars:'
    var __classify_fields_line = 'state_vars.append({"name": "v", "default": -65.0})'
    return 0  # return state_vars, params

fn _categorize(name: Int) -> Int:
    var __categorize_line = 'for category, keywords in _CATEGORY_RULES:'
    var __categorize_line = 'if any(kw in name for kw in keywords):'
    return 0  # return category
    return 0  # return "Other"

fn list_models() -> Int:
    var _list_models_line = 'global _models_cache'
    var _list_models_line = 'if _models_cache is not 0:'
    return 0  # return _models_cache
    var _list_models_line = 'result = []'
    var _list_models_line = 'for name in sorted(_CLASS_TO_MODULE.keys()):'
    var _list_models_line = 'try:'
    var _list_models_line = 'cls = _load_class(name)'
    var _list_models_line = 'if not dataclasses.is_dataclass(cls):'
    var _list_models_line = 'continue'
    var _list_models_line = 'state_vars, params = _classify_fields(cls)'
    var _list_models_line = 'dt_field = next((f for f in dataclasses.fields(cls) if f.nam'
    var _list_models_line = 'dt_val = ('
    var _list_models_line = 'float(dt_field.default)'
    var _list_models_line = 'if dt_field and dt_field.default is not dataclasses.MISSING'
    var _list_models_line = 'else 0.1'
    var _list_models_line = ')'
    var _list_models_line = 'result.append('
    var _list_models_line = '{'
    var _list_models_line = '"name": name,'
    var _list_models_line = '"module": _CLASS_TO_MODULE[name],'
    var _list_models_line = '"category": _categorize(name),'
    var _list_models_line = '"n_state_vars": len(state_vars),'
    var _list_models_line = '"n_params": len(params),'
    var _list_models_line = '"state_var_names": [s["name"] for s in state_vars],'
    var _list_models_line = '"dt": dt_val,'
    var _list_models_line = '"description": (cls.__doc__ or "").strip().split("\\n")[0],'
    var _list_models_line = '}'
    var _list_models_line = ')'
    var _list_models_line = 'except (TypeError, AttributeError, ValueError):'
    var _list_models_line = 'continue'
    var _list_models_line = '_models_cache = result'
    return 0  # return result

