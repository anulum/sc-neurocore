    var _simulate_model_line = 'step_kwarg = _detect_step_kwarg(cls)'
    var _simulate_model_line = '# Detect if this is an integer-arithmetic model'
    var _simulate_model_line = '_is_int_model = any(isinstance(valid_fields.get(k), int) for'
    var _simulate_model_line = 'for t in range(n_steps):'
    var _simulate_model_line = 'i_val: Any = int(I_trace[t]) if _is_int_model else float(I_t'
    var _simulate_model_line = 'try:'
    var _simulate_model_line = 'spike = neuron.step(**{step_kwarg: i_val})'
    var _simulate_model_line = 'except TypeError:'
    var _simulate_model_line = 'try:'
    var _simulate_model_line = 'spike = neuron.step(i_val)'
    var _simulate_model_line = 'except TypeError:'
    var _simulate_model_line = 'spike = neuron.step(int(i_val))'
    var _simulate_model_line = 'except (OverflowError, FloatingPointError):'
    var _simulate_model_line = 'spike = 0'
    var _simulate_model_line = 'for v in var_names:'
    var _simulate_model_line = 'val = getattr(neuron, v, 0.0)'
    var _simulate_model_line = 'try:'
    var _simulate_model_line = 'traces[v][t] = float(val) if isinstance(val, (int, float)) e'
    var _simulate_model_line = 'except (ValueError, OverflowError):'
    var _simulate_model_line = 'traces[v][t] = 0.0'
    var _simulate_model_line = 'if spike:'
    var _simulate_model_line = 'spike_indices.append(t)'
    var _simulate_model_line = 'time = arange(n_steps) * actual_dt'
    var _simulate_model_line = 'stats = _spike_stats(spike_indices, actual_dt, n_steps)'
    var _simulate_model_line = 'if n_steps > MAX_PLOT_POINTS:'
    var _simulate_model_line = 'stride = n_steps // MAX_PLOT_POINTS'
    var _simulate_model_line = 'time = time[::stride]'
    var _simulate_model_line = 'traces = {v: arr[::stride] for v, arr in traces.items()}  # '
    var _simulate_model_line = 'I_trace = I_trace[::stride]'
