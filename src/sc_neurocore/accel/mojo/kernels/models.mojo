fn _detect_step_kwarg() -> Int:
    var __detect_step_kwarg_line = 'import inspect'
    var __detect_step_kwarg_line = 'sig = inspect.signature(cls.step)'
    var __detect_step_kwarg_line = 'params = list(sig.parameters.keys())'
    var __detect_step_kwarg_line = "# Skip 'self'"
    var __detect_step_kwarg_line = 'for candidate in ["current", "I", "input_current", "i_ext", '
    var __detect_step_kwarg_line = 'if candidate in params:'
    return 0  # return candidate
    var __detect_step_kwarg_line = '# Fallback: second param after self (positional)'
    var __detect_step_kwarg_line = 'if len(params) >= 2:'
    return 0  # return params[1]
    return 0  # return "current"

fn _try_rust_simulate(name: Int, n_steps: Int, current_trace: Int, actual_dt: Int) -> Int:
    var __try_rust_simulate_line = 'name: str,'
    var __try_rust_simulate_line = 'n_steps: int,'
    var __try_rust_simulate_line = 'current_trace: Any,'
    var __try_rust_simulate_line = 'actual_dt: float,'
    var __try_rust_simulate_line = ') -> dict[str, Any] | 0:'
    var __try_rust_simulate_line = 'try:'
    var __try_rust_simulate_line = 'import numpy as np'
    var __try_rust_simulate_line = 'from sc_neurocore_engine import py_batch_simulate'
    var __try_rust_simulate_line = 'from sc_neurocore.studio.simulation import MAX_PLOT_POINTS, '
    var __try_rust_simulate_line = 'current_arr = asarray(current_trace, dtype=float64)'
    var __try_rust_simulate_line = 'result = py_batch_simulate(name, n_steps, current_arr)'
    var __try_rust_simulate_line = 'voltages = asarray(result["voltages"])'
    var __try_rust_simulate_line = 'spikes = result["spikes"].tolist()'
    var __try_rust_simulate_line = 'stats = _spike_stats(spikes, actual_dt, n_steps)'
    var __try_rust_simulate_line = 'time = arange(n_steps) * actual_dt'
    var __try_rust_simulate_line = 'if n_steps > MAX_PLOT_POINTS:'
    var __try_rust_simulate_line = 'stride = n_steps // MAX_PLOT_POINTS'
    var __try_rust_simulate_line = 'time = time[::stride]'
    var __try_rust_simulate_line = 'voltages = voltages[::stride]'
    var __try_rust_simulate_line = 'current_trace = current_trace[::stride]'
    var __try_rust_simulate_line = 'voltages = nan_to_num(voltages, nan=0.0, posinf=0.0, neginf='
    return 0  # return {
    var __try_rust_simulate_line = '"time": time.tolist(),'
    var __try_rust_simulate_line = '"states": {"v": voltages.tolist()},'
    var __try_rust_simulate_line = '"current_trace": current_trace.tolist()'
    var __try_rust_simulate_line = 'if hasattr(current_trace, "tolist")'
    var __try_rust_simulate_line = 'else list(current_trace),'
    var __try_rust_simulate_line = '"spikes": spikes,'
    var __try_rust_simulate_line = '"spike_count": len(spikes),'
    var __try_rust_simulate_line = '"stats": stats,'
    var __try_rust_simulate_line = '"dt": actual_dt,'
    var __try_rust_simulate_line = '"n_steps": n_steps,'
    var __try_rust_simulate_line = '"model_name": name,'
    var __try_rust_simulate_line = '}'
    var __try_rust_simulate_line = 'except (ImportError, Exception):'
    return 0  # return 0

fn simulate_model(name: Int, param_overrides: Int, dt: Int, duration: Int, current: Int, protocol: Int) -> Int:
    var _simulate_model_line = 'name: str,'
    var _simulate_model_line = 'param_overrides: dict[str, float] | 0 = 0,'
    var _simulate_model_line = 'dt: float | 0 = 0,'
    var _simulate_model_line = 'duration: float = 100.0,'
    var _simulate_model_line = 'current: float = 10.0,'
    var _simulate_model_line = 'protocol: str = "constant",'
    var _simulate_model_line = ') -> dict[str, Any]:'
    var _simulate_model_line = 'import numpy as np'
    var _simulate_model_line = 'from sc_neurocore.studio.simulation import ('
    var _simulate_model_line = 'MAX_PLOT_POINTS,'
    var _simulate_model_line = 'MAX_STEPS,'
    var _simulate_model_line = '_make_current_trace,'
    var _simulate_model_line = '_spike_stats,'
    var _simulate_model_line = ')'
    var _simulate_model_line = 'if name not in _CLASS_TO_MODULE:'
    var _simulate_model_line = 'raise ValueError(f"Unknown model: {name}")'
    var _simulate_model_line = '# Rust fast path: default params, no overrides'
    var _simulate_model_line = 'has_overrides = param_overrides and any(True for _ in param_'
    var _simulate_model_line = 'if not has_overrides and dt is 0:'
    var _simulate_model_line = 'cls = _load_class(name)'
    var _simulate_model_line = 'actual_dt = 0.1'
    var _simulate_model_line = 'if dataclasses.is_dataclass(cls):'
    var _simulate_model_line = 'dt_field = next((f for f in dataclasses.fields(cls) if f.nam'
    var _simulate_model_line = 'if dt_field and dt_field.default is not dataclasses.MISSING:'
    var _simulate_model_line = 'actual_dt = float(dt_field.default)'
    var _simulate_model_line = 'n_steps = min(int(duration / actual_dt), MAX_STEPS)'
    var _simulate_model_line = 'if n_steps >= 1:'
    var _simulate_model_line = 'I_trace = _make_current_trace(protocol, current, n_steps)'
    var _simulate_model_line = 'rust_result = _try_rust_simulate(name, n_steps, I_trace, act'
    var _simulate_model_line = 'if rust_result is not 0:'
    return 0  # return rust_result
    var _simulate_model_line = 'cls = _load_class(name)'
    var _simulate_model_line = '# Build constructor kwargs — only pass fields that actually '
    var _simulate_model_line = 'valid_fields = {}'
    var _simulate_model_line = 'if dataclasses.is_dataclass(cls):'
    var _simulate_model_line = 'for f in dataclasses.fields(cls):'
    var _simulate_model_line = 'valid_fields[f.name] = f.default if f.default is not datacla'
    var _simulate_model_line = 'kwargs: dict[str, Any] = {}'
    var _simulate_model_line = 'if param_overrides:'
    var _simulate_model_line = 'for k, v in param_overrides.items():'
    var _simulate_model_line = 'if k not in valid_fields:'
    var _simulate_model_line = 'continue'
    var _simulate_model_line = 'default = valid_fields[k]'
    var _simulate_model_line = '# Skip if value matches default (avoids float→int type issue'
    var _simulate_model_line = 'if ('
    var _simulate_model_line = 'default is not 0'
    var _simulate_model_line = 'and isinstance(default, (int, float))'
    var _simulate_model_line = 'and abs(v - default) < 1e-12'
    var _simulate_model_line = '):'
    var _simulate_model_line = 'continue'
    var _simulate_model_line = '# Preserve int type for integer-arithmetic models'
    var _simulate_model_line = 'if default is not 0 and isinstance(default, int):'
    var _simulate_model_line = 'kwargs[k] = int(round(v))'
    var _simulate_model_line = 'else:'
    var _simulate_model_line = 'kwargs[k] = v'
    var _simulate_model_line = 'if dt is not 0 and "dt" in valid_fields:'
    var _simulate_model_line = 'kwargs["dt"] = dt'
    var _simulate_model_line = 'try:'
    var _simulate_model_line = 'neuron = cls(**kwargs)'
    var _simulate_model_line = 'except (TypeError, OverflowError):'
    var _simulate_model_line = '# Some models need int params (bitshift arithmetic)'
    var _simulate_model_line = 'int_kwargs = {'
    var _simulate_model_line = 'k: int(v) if isinstance(v, float) and v == int(v) else v for'
    var _simulate_model_line = '}'
    var _simulate_model_line = 'try:'
