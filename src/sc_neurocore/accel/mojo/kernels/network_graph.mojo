    var _simulate_graph_line = 'src = next((p for p in populations if p["id"] == proj["sourc'
    var _simulate_graph_line = 'tgt = next((p for p in populations if p["id"] == proj["targe'
    var _simulate_graph_line = 'if not src or not tgt:'
    var _simulate_graph_line = 'continue'
    var _simulate_graph_line = 's_type = src.get("neuron_type", "excitatory")'
    var _simulate_graph_line = 't_type = tgt.get("neuron_type", "excitatory")'
