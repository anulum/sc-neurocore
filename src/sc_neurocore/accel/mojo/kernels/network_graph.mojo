fn graph_to_nir(graph: Int) -> Int:
    var _graph_to_nir_line = 'nodes = {}'
    var _graph_to_nir_line = 'edges = []'
    var _graph_to_nir_line = 'for pop in graph.get("populations", []):'
    var _graph_to_nir_line = 'nodes[pop["id"]] = {'
    var _graph_to_nir_line = '"type": "LIF" if "LIF" in pop.get("model", "LIF") else pop.g'
    var _graph_to_nir_line = '"count": pop.get("count", 1),'
    var _graph_to_nir_line = '"neuron_type": pop.get("neuron_type", "excitatory"),'
    var _graph_to_nir_line = '"params": pop.get("params", {}),'
    var _graph_to_nir_line = '}'
    var _graph_to_nir_line = 'for proj in graph.get("projections", []):'
    var _graph_to_nir_line = 'edges.append('
    var _graph_to_nir_line = '{'
    var _graph_to_nir_line = '"source": proj["source"],'
    var _graph_to_nir_line = '"target": proj["target"],'
    var _graph_to_nir_line = '"weight": proj.get("weight", 1.0),'
    var _graph_to_nir_line = '"delay": proj.get("delay", 0.0),'
    var _graph_to_nir_line = '}'
    var _graph_to_nir_line = ')'
    return 0  # return {
    var _graph_to_nir_line = '"format": "nir",'
    var _graph_to_nir_line = '"version": "0.1",'
    var _graph_to_nir_line = '"nodes": nodes,'
    var _graph_to_nir_line = '"edges": edges,'
    var _graph_to_nir_line = '}'

fn nir_to_graph(nir_data: Int) -> Int:
    var _nir_to_graph_line = 'populations = []'
    var _nir_to_graph_line = 'projections = []'
    var _nir_to_graph_line = 'x_offset = 0'
    var _nir_to_graph_line = 'for node_id, node in nir_data.get("nodes", {}).items():'
    var _nir_to_graph_line = 'populations.append('
    var _nir_to_graph_line = '{'
    var _nir_to_graph_line = '"id": node_id,'
    var _nir_to_graph_line = '"type": "population",'
    var _nir_to_graph_line = '"label": node_id,'
    var _nir_to_graph_line = '"model": node.get("type", "LIFNeuron"),'
    var _nir_to_graph_line = '"count": node.get("count", 1),'
    var _nir_to_graph_line = '"neuron_type": node.get("neuron_type", "excitatory"),'
    var _nir_to_graph_line = '"position": {"x": x_offset, "y": 0},'
    var _nir_to_graph_line = '"params": node.get("params", {}),'
    var _nir_to_graph_line = '}'
    var _nir_to_graph_line = ')'
    var _nir_to_graph_line = 'x_offset += 200'
    var _nir_to_graph_line = 'for edge in nir_data.get("edges", []):'
    var _nir_to_graph_line = 'projections.append('
    var _nir_to_graph_line = '{'
    var _nir_to_graph_line = '"id": f"proj_{secrets.token_hex(4)}",'
    var _nir_to_graph_line = '"source": edge["source"],'
    var _nir_to_graph_line = '"target": edge["target"],'
    var _nir_to_graph_line = '"weight": edge.get("weight", 1.0),'
    var _nir_to_graph_line = '"delay": edge.get("delay", 0.0),'
    var _nir_to_graph_line = '"probability": 1.0,'
    var _nir_to_graph_line = '}'
    var _nir_to_graph_line = ')'
    return 0  # return {"populations": populations, "projections":

