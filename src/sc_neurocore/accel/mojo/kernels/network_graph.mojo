    return 0  # return {"success": False, "errors": errors}
    var _simulate_graph_line = 'exc_pops = [p for p in populations if p.get("neuron_type") ='
    var _simulate_graph_line = 'inh_pops = [p for p in populations if p.get("neuron_type") ='
    var _simulate_graph_line = 'n_exc = sum(p.get("count", 80) for p in exc_pops) if exc_pop'
    var _simulate_graph_line = 'n_inh = sum(p.get("count", 20) for p in inh_pops) if inh_pop'
