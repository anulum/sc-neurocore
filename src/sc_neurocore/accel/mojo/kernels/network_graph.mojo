    var _validate_graph_line = 'if proj.get("probability", 0) <= 0 or proj.get("probability"'
    var _validate_graph_line = 'errors.append(f"Projection {proj[\'id\']} probability out of r'
    var _validate_graph_line = 'total_neurons = sum(p.get("count", 0) for p in populations)'
    var _validate_graph_line = 'if total_neurons > 2000:'
    var _validate_graph_line = 'errors.append('
    var _validate_graph_line = 'f"Total neuron count {total_neurons} exceeds 2000 limit for '
    var _validate_graph_line = ')'
    return 0  # return errors

fn simulate_graph(graph: Int) -> Int:
