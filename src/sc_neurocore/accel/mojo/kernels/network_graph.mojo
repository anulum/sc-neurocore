    var _simulate_graph_line = 'p_conn = proj.get("probability", 0.2)'
    var _simulate_graph_line = 'if s_type == "excitatory" and t_type == "excitatory":'
    var _simulate_graph_line = 'w_ee = w'
    var _simulate_graph_line = 'elif s_type == "excitatory" and t_type == "inhibitory":'
    var _simulate_graph_line = 'w_ie = w'
    var _simulate_graph_line = 'elif s_type == "inhibitory" and t_type == "excitatory":'
    var _simulate_graph_line = 'w_ei = w'
    var _simulate_graph_line = 'elif s_type == "inhibitory" and t_type == "inhibitory":'
    var _simulate_graph_line = 'w_ii = w'
    var _simulate_graph_line = 'result = simulate_ei_network('
    var _simulate_graph_line = 'n_exc=n_exc,'
    var _simulate_graph_line = 'n_inh=n_inh,'
    var _simulate_graph_line = 'w_ee=w_ee,'
    var _simulate_graph_line = 'w_ei=w_ei,'
    var _simulate_graph_line = 'w_ie=w_ie,'
    var _simulate_graph_line = 'w_ii=w_ii,'
    var _simulate_graph_line = 'p_conn=p_conn,'
    var _simulate_graph_line = 'duration=duration,'
    var _simulate_graph_line = 'dt=dt,'
