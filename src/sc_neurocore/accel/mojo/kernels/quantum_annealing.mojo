fn decompose(model: Int) -> Int:
    var _decompose_line = 'if model.n_qubits <= _max_size:'
    return 0  # return [model]
    var _decompose_line = '# Build adjacency'
    var _decompose_line = 'neighbors: Dict[int, list[int]] = {i: [] for i in range(mode'
    var _decompose_line = 'for i, j in model.J:'
    var _decompose_line = 'neighbors[i].append(j)'
