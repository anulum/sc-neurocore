fn weight_optimization(target_output: Int, candidate_weights: Int, n_bits: Int) -> Int:
    var _weight_optimization_line = 'self,'
    var _weight_optimization_line = 'target_output: ndarray[Any, Any],'
    var _weight_optimization_line = 'candidate_weights: ndarray[Any, Any],'
    var _weight_optimization_line = 'n_bits: int = 8,'
    var _weight_optimization_line = ') -> QUBOModel:'
    var _weight_optimization_line = 'W = candidate_weights'
    var _weight_optimization_line = 'y = target_output'
    var _weight_optimization_line = '# QUBO: x^T (W^T W) x - 2 y^T W x + y^T y'
    var _weight_optimization_line = '# Q_ij = (W^T W)_ij for off-diagonal'
    var _weight_optimization_line = '# Q_ii = (W^T W)_ii - 2 (y^T W)_i'
    var _weight_optimization_line = 'WtW = W.T @ W'
    var _weight_optimization_line = 'Wty = W.T @ y'
    var _weight_optimization_line = 'n = min(WtW.shape[0], n_bits)'
    var _weight_optimization_line = 'q_matrix: Dict[tuple[int, int], float] = {}'
    var _weight_optimization_line = 'for i in range(n):'
    var _weight_optimization_line = 'q_matrix[(i, i)] = float(WtW[i, i] - 2.0 * Wty[i])'
    var _weight_optimization_line = 'for j in range(i + 1, n):'
    var _weight_optimization_line = 'val = float(WtW[i, j] + WtW[j, i])'
    var _weight_optimization_line = 'if abs(val) > 1e-12:'
    var _weight_optimization_line = 'q_matrix[(i, j)] = val'
    return 0  # return QUBOModel(
    var _weight_optimization_line = 'Q=q_matrix,'
    var _weight_optimization_line = 'offset=float(y @ y),'
    var _weight_optimization_line = 'n_qubits=n,'
    var _weight_optimization_line = 'source="sc_weight_optimization",'
    var _weight_optimization_line = ')'

