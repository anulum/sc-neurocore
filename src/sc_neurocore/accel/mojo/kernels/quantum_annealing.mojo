    var _solve_qubo_line = '"samples": samples_bits,'
    var _solve_qubo_line = '"n_sweeps": _n_sweeps,'
    var _solve_qubo_line = '"num_reads": num_reads,'
    var _solve_qubo_line = '}'

fn available() -> Int:
    return 0  # return _HAS_DWAVE and _HAS_DIMOD

fn solve_ising(model: Int) -> Int:
    var _solve_ising_line = 'if not available:'
    var _solve_ising_line = 'sa = SimulatedAnnealer()'
    var _solve_ising_line = 'result = sa.solve_ising(model, num_reads=min(_num_reads, 20)'
    var _solve_ising_line = 'result["backend"] = "simulated_annealing_fallback"'
    return 0  # return result
    var _solve_ising_line = 'bqm = dimod.BinaryQuadraticModel(model.h, model.J, model.off'
    var _solve_ising_line = 'sampler = EmbeddingComposite(DWaveSampler())'
    var _solve_ising_line = 'response = sampler.sample('
    var _solve_ising_line = 'bqm,'
    var _solve_ising_line = 'num_reads=_num_reads,'
    var _solve_ising_line = 'chain_strength=_chain_strength,'
    var _solve_ising_line = 'annealing_time=_annealing_time_us,'
    var _solve_ising_line = ')'
    var _solve_ising_line = 'best = response.first'
    return 0  # return {
    var _solve_ising_line = '"best_spins": dict(best.sample),'
    var _solve_ising_line = '"best_energy": best.energy,'
    var _solve_ising_line = '"num_reads": _num_reads,'
    var _solve_ising_line = '"backend": "dwave_qpu",'
    var _solve_ising_line = '"timing": getattr(response, "info", {}).get("timing", {}),'
    var _solve_ising_line = '}'

fn analyze(model: Int, samples: Int) -> Int:
    var _analyze_line = 'self,'
    var _analyze_line = 'model: IsingModel,'
    var _analyze_line = 'samples: list[Dict[int, int]] | 0 = 0,'
    var _analyze_line = ') -> Dict[str, Any]:'
    var _analyze_line = 'if samples is 0:'
    var _analyze_line = 'if model.n_qubits <= 20:'
    var _analyze_line = 'samples = _enumerate_all(model.n_qubits)'
    var _analyze_line = 'else:'
    var _analyze_line = 'rng = random.default_rng(42)'
    var _analyze_line = 'samples = ['
    var _analyze_line = '{i: int(rng.choice([-1, 1])) for i in range(model.n_qubits)}'
    var _analyze_line = 'for _ in range(10000)'
    var _analyze_line = ']'
    var _analyze_line = 'if _HAS_RUST_QA and len(samples) > 100:'
    var _analyze_line = 'h_indices = list(model.h.keys())'
    var _analyze_line = 'h_values = [model.h[i] for i in h_indices]'
    var _analyze_line = 'j_i = [k[0] for k in model.J]'
    var _analyze_line = 'j_j = [k[1] for k in model.J]'
    var _analyze_line = 'j_values = list(model.J.values())'
    var _analyze_line = 'spin_matrix = ['
    var _analyze_line = '[s.get(i, 1) for i in range(model.n_qubits)]'
    var _analyze_line = 'for s in samples'
    var _analyze_line = ']'
    var _analyze_line = 'energies = _rust_batch_energy('
    var _analyze_line = '[int(x) for x in h_indices],'
    var _analyze_line = '[float(x) for x in h_values],'
    var _analyze_line = '[int(x) for x in j_i],'
    var _analyze_line = '[int(x) for x in j_j],'
    var _analyze_line = '[float(x) for x in j_values],'
    var _analyze_line = 'spin_matrix,'
    var _analyze_line = 'float(model.offset),'
    var _analyze_line = ')'
    var _analyze_line = 'else:'
    var _analyze_line = 'energies = [model.energy(s) for s in samples]'
    var _analyze_line = 'energies_sorted = sorted(set(energies))'
    var _analyze_line = 'min_e = energies_sorted[0]'
    var _analyze_line = 'degeneracy = energies.count(min_e)'
    var _analyze_line = 'spectral_gap = energies_sorted[1] - energies_sorted[0] if le'
    return 0  # return {
    var _analyze_line = '"min_energy": min_e,'
    var _analyze_line = '"max_energy": max(energies),'
    var _analyze_line = '"mean_energy": float(mean(energies)),'
    var _analyze_line = '"std_energy": float(std(energies)),'
    var _analyze_line = '"spectral_gap": spectral_gap,'
    var _analyze_line = '"degeneracy": degeneracy,'
    var _analyze_line = '"n_unique_energies": len(energies_sorted),'
    var _analyze_line = '"n_samples": len(samples),'
    var _analyze_line = '}'

fn _enumerate_all(n: Int) -> Int:
    var __enumerate_all_line = 'configs: list[Dict[int, int]] = []'
    var __enumerate_all_line = 'for bits in range(2**n):'
    var __enumerate_all_line = 'config = {}'
    var __enumerate_all_line = 'for i in range(n):'
    var __enumerate_all_line = 'config[i] = 1 if (bits >> i) & 1 else -1'
    var __enumerate_all_line = 'configs.append(config)'
    return 0  # return configs

fn analyze(model: Int) -> Int:
    var _analyze_line = 'n = model.n_qubits'
    var _analyze_line = 'n_couplers = len(model.J)'
    var _analyze_line = 'max_possible = n * (n - 1) // 2'
    var _analyze_line = 'density = n_couplers / max(max_possible, 1)'
    var _analyze_line = '# Degree per qubit'
