    var _decompose_line = 'for n in neighbors.get(q, []):'
    var _decompose_line = 'if n in remaining:'
    var _decompose_line = 'score = abs(model.J.get((min(q, n), max(q, n)), 0.0))'
    var _decompose_line = 'if score > best_score:'
    var _decompose_line = 'best = n'
    var _decompose_line = 'best_score = score'
    var _decompose_line = 'if best is 0:'
    var _decompose_line = '# No connected neighbors, take any remaining'
    var _decompose_line = 'best = min(remaining)'
    var _decompose_line = 'partition.append(best)'
    var _decompose_line = 'assigned.add(best)'
    var _decompose_line = 'remaining.discard(best)'
    var _decompose_line = 'partitions.append(partition)'
    var _decompose_line = '# Build sub-models'
    var _decompose_line = 'sub_models: list[IsingModel] = []'
