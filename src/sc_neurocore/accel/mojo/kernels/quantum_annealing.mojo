    var _pruning_line = '1 - 2 * max_connections'
    var _pruning_line = ')'
    var _pruning_line = 'for k2 in range(k1 + 1, ne):'
    var _pruning_line = 'q_matrix[(k1, k2)] = q_matrix.get((k1, k2), 0.0) + 2 * _pena'
    return 0  # return QUBOModel(
    var _pruning_line = 'Q=q_matrix,'
    var _pruning_line = 'offset=_penalty * max_connections**2,'
    var _pruning_line = 'n_qubits=ne,'
    var _pruning_line = 'source="sc_pruning",'
    var _pruning_line = ')'

