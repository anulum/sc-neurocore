    var _solve_ising_line = 'self,'
    var _solve_ising_line = 'model: IsingModel,'
    var _solve_ising_line = 'num_reads: int = 10,'
    var _solve_ising_line = ') -> Dict[str, Any]:'
    var _solve_ising_line = 'if _HAS_RUST_QA and model.n_qubits > 10:'
    return 0  # return _solve_ising_rust(model, num_reads)
    return 0  # return _solve_ising_python(model, num_reads)

fn _solve_ising_rust(model: Int, num_reads: Int) -> Int:
    var __solve_ising_rust_line = 'self,'
    var __solve_ising_rust_line = 'model: IsingModel,'
    var __solve_ising_rust_line = 'num_reads: int,'
    var __solve_ising_rust_line = ') -> Dict[str, Any]:'
    var __solve_ising_rust_line = 'h_indices = list(model.h.keys())'
    var __solve_ising_rust_line = 'h_values = [model.h[i] for i in h_indices]'
    var __solve_ising_rust_line = 'j_i = [k[0] for k in model.J]'
    var __solve_ising_rust_line = 'j_j = [k[1] for k in model.J]'
    var __solve_ising_rust_line = 'j_values = list(model.J.values())'
    var __solve_ising_rust_line = 'result = _rust_sa('
    var __solve_ising_rust_line = '[int(x) for x in h_indices],'
    var __solve_ising_rust_line = '[float(x) for x in h_values],'
    var __solve_ising_rust_line = '[int(x) for x in j_i],'
    var __solve_ising_rust_line = '[int(x) for x in j_j],'
    var __solve_ising_rust_line = '[float(x) for x in j_values],'
    var __solve_ising_rust_line = 'int(model.n_qubits),'
    var __solve_ising_rust_line = 'float(model.offset),'
    var __solve_ising_rust_line = 'int(_n_sweeps),'
    var __solve_ising_rust_line = 'int(num_reads),'
    var __solve_ising_rust_line = 'float(_beta_start),'
    var __solve_ising_rust_line = 'float(_beta_end),'
    var __solve_ising_rust_line = '42,'
    var __solve_ising_rust_line = ')'
    var __solve_ising_rust_line = 'best_spins_list = result["best_spins"]'
    var __solve_ising_rust_line = 'best_spins = {i: int(s) for i, s in enumerate(best_spins_lis'
    var __solve_ising_rust_line = 'samples = []'
    var __solve_ising_rust_line = 'for sample_list in result.get("samples", []):'
    var __solve_ising_rust_line = 'samples.append({i: int(s) for i, s in enumerate(sample_list)'
    return 0  # return {
    var __solve_ising_rust_line = '"best_spins": best_spins,'
    var __solve_ising_rust_line = '"best_energy": result["best_energy"],'
    var __solve_ising_rust_line = '"energies": result.get("energies", []),'
    var __solve_ising_rust_line = '"samples": samples,'
    var __solve_ising_rust_line = '"n_sweeps": _n_sweeps,'
    var __solve_ising_rust_line = '"num_reads": num_reads,'
    var __solve_ising_rust_line = '"backend": "rust",'
    var __solve_ising_rust_line = '}'

fn _solve_ising_python(model: Int, num_reads: Int) -> Int:
    var __solve_ising_python_line = 'self,'
    var __solve_ising_python_line = 'model: IsingModel,'
    var __solve_ising_python_line = 'num_reads: int,'
    var __solve_ising_python_line = ') -> Dict[str, Any]:'
    var __solve_ising_python_line = 'n = model.n_qubits'
    var __solve_ising_python_line = 'best_energy = float("inf")'
    var __solve_ising_python_line = 'best_spins: Dict[int, int] = {}'
    var __solve_ising_python_line = 'all_energies: list[float] = []'
    var __solve_ising_python_line = 'all_samples: list[Dict[int, int]] = []'
    var __solve_ising_python_line = 'for _ in range(num_reads):'
    var __solve_ising_python_line = 'spins = {i: int(_rng.choice([-1, 1])) for i in range(n)}'
    var __solve_ising_python_line = 'energy = model.energy(spins)'
    var __solve_ising_python_line = 'for sweep in range(_n_sweeps):'
    var __solve_ising_python_line = 'beta = _beta_start * ('
    var __solve_ising_python_line = '(_beta_end / _beta_start) ** (sweep / max(_n_sweeps - 1, 1))'
    var __solve_ising_python_line = ')'
    var __solve_ising_python_line = 'for qubit in range(n):'
    var __solve_ising_python_line = '# ΔE for flipping s_q → -s_q is'
    var __solve_ising_python_line = '#   ΔE = −2·s_q·(h_q + Σ_k J_qk·s_k).'
    var __solve_ising_python_line = 'local_field = model.h.get(qubit, 0.0)'
    var __solve_ising_python_line = 'for (i, j), jij in model.J.items():'
    var __solve_ising_python_line = 'if i == qubit:'
    var __solve_ising_python_line = 'local_field += jij * spins.get(j, 1)'
    var __solve_ising_python_line = 'elif j == qubit:'
    var __solve_ising_python_line = 'local_field += jij * spins.get(i, 1)'
    var __solve_ising_python_line = 'de = -2.0 * spins[qubit] * local_field'
    var __solve_ising_python_line = 'if de < 0 or _rng.random() < math.exp(-beta * de):'
    var __solve_ising_python_line = 'spins[qubit] *= -1'
    var __solve_ising_python_line = 'energy += de'
    var __solve_ising_python_line = 'all_energies.append(energy)'
    var __solve_ising_python_line = 'all_samples.append(dict(spins))'
    var __solve_ising_python_line = 'if energy < best_energy:'
    var __solve_ising_python_line = 'best_energy = energy'
    var __solve_ising_python_line = 'best_spins = dict(spins)'
    return 0  # return {
    var __solve_ising_python_line = '"best_spins": best_spins,'
    var __solve_ising_python_line = '"best_energy": best_energy,'
    var __solve_ising_python_line = '"energies": all_energies,'
    var __solve_ising_python_line = '"samples": all_samples,'
    var __solve_ising_python_line = '"n_sweeps": _n_sweeps,'
    var __solve_ising_python_line = '"num_reads": num_reads,'
    var __solve_ising_python_line = '"backend": "python",'
    var __solve_ising_python_line = '}'

