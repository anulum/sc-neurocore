    var _decompose_line = 'partitions: list[list[int]] = []'
    var _decompose_line = 'remaining = set(range(model.n_qubits))'
    var _decompose_line = 'while remaining:'
    var _decompose_line = 'seed = min(remaining)'
    var _decompose_line = 'partition = [seed]'
    var _decompose_line = 'assigned.add(seed)'
    var _decompose_line = 'remaining.discard(seed)'
    var _decompose_line = 'while len(partition) < _max_size and remaining:'
    var _decompose_line = '# Find unassigned neighbor of current partition'
    var _decompose_line = 'best = 0'
    var _decompose_line = 'best_score = -1'
