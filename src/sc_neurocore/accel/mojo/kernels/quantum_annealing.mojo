    var _solve_qubo_line = '# Convert spins → bits'
    var _solve_qubo_line = 'best_bits = {i: (s + 1) // 2 for i, s in result["best_spins"'
    var _solve_qubo_line = 'samples_bits = ['
    var _solve_qubo_line = '{i: (s + 1) // 2 for i, s in sample.items()} for sample in r'
    var _solve_qubo_line = ']'
    return 0  # return {
    var _solve_qubo_line = '"best_bits": best_bits,'
    var _solve_qubo_line = '"best_energy": model.energy(best_bits),'
