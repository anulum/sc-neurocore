fn visualize_ising(model: Int) -> Int:
    var _visualize_ising_line = 'lines: list[str] = ['
    var _visualize_ising_line = 'f"┌{\'=\' * 50}┐",'
    var _visualize_ising_line = 'f"│ Ising Model: {model.source:<34} │",'
    var _visualize_ising_line = 'f"│ Qubits: {model.n_qubits:<4}  Couplers: {len(model.J):<5}'
    var _visualize_ising_line = 'f"│ Offset: {model.offset:<40.4f} │",'
    var _visualize_ising_line = 'f"└{\'=\' * 50}┘",'
    var _visualize_ising_line = '"",'
    var _visualize_ising_line = '"  Biases (h):",'
    var _visualize_ising_line = ']'
    var _visualize_ising_line = 'for i in sorted(model.h.keys()):'
    var _visualize_ising_line = 'label = model.qubit_labels.get(i, f"q{i}")'
    var _visualize_ising_line = 'bar_len = int(abs(model.h[i]) * 20)'
    var _visualize_ising_line = 'bar = "█" * min(bar_len, 20)'
    var _visualize_ising_line = 'sign = "+" if model.h[i] >= 0 else "-"'
    var _visualize_ising_line = 'lines.append(f"    {label:>8}: {sign}{bar:<20} ({model.h[i]:'
    var _visualize_ising_line = 'lines.append("")'
    var _visualize_ising_line = 'lines.append("  Couplings (J):")'
    var _visualize_ising_line = 'for i, j in sorted(model.J.keys()):'
    var _visualize_ising_line = 'li = model.qubit_labels.get(i, f"q{i}")'
    var _visualize_ising_line = 'lj = model.qubit_labels.get(j, f"q{j}")'
    var _visualize_ising_line = 'jij = model.J[(i, j)]'
    var _visualize_ising_line = 'kind = "ferro" if jij < 0 else "anti"'
    var _visualize_ising_line = 'lines.append(f"    {li:>8} ─── {lj:<8}: {jij:+.4f} [{kind}]"'
    return 0  # return "\n".join(lines)

fn energy(spins: Int) -> Int:
    var _energy_line = 'if _HAS_RUST_QA and n_qubits > 20:'
    var _energy_line = 'h_indices = list(h.keys())'
    var _energy_line = 'h_values = [h[i] for i in h_indices]'
    var _energy_line = 'j_i = [k[0] for k in J]'
    var _energy_line = 'j_j = [k[1] for k in J]'
    var _energy_line = 'j_values = list(J.values())'
    var _energy_line = 'spin_arr = [spins.get(i, 1) for i in range(n_qubits)]'
    return 0  # return _rust_ising_energy(
    var _energy_line = 'h_indices, h_values, j_i, j_j, j_values,'
    var _energy_line = 'spin_arr, offset,'
    var _energy_line = ')'
    var _energy_line = 'e = offset'
    var _energy_line = 'for i, hi in h.items():'
    var _energy_line = 'e += hi * spins.get(i, 1)'
    var _energy_line = 'for (i, j), jij in J.items():'
    var _energy_line = 'e += jij * spins.get(i, 1) * spins.get(j, 1)'
    return 0  # return e

fn energy(bits: Int) -> Int:
    var _energy_line = 'e = offset'
    var _energy_line = 'for (i, j), qij in Q.items():'
    var _energy_line = 'e += qij * bits.get(i, 0) * bits.get(j, 0)'
    return 0  # return e

fn to_ising() -> Int:
    var _to_ising_line = 'h: Dict[int, float] = {}'
    var _to_ising_line = 'j_couplings: Dict[tuple[int, int], float] = {}'
    var _to_ising_line = 'offset = offset'
    var _to_ising_line = 'for (i, j), qij in Q.items():'
    var _to_ising_line = 'if i == j:'
    var _to_ising_line = 'h[i] = h.get(i, 0.0) + qij / 2.0'
    var _to_ising_line = 'offset += qij / 4.0'
    var _to_ising_line = 'else:'
    var _to_ising_line = 'a, b = min(i, j), max(i, j)'
    var _to_ising_line = 'j_couplings[(a, b)] = j_couplings.get((a, b), 0.0) + qij / 4'
    var _to_ising_line = 'h[i] = h.get(i, 0.0) + qij / 4.0'
    var _to_ising_line = 'h[j] = h.get(j, 0.0) + qij / 4.0'
    var _to_ising_line = 'offset += qij / 4.0'
    return 0  # return IsingModel(
    var _to_ising_line = 'h=h,'
    var _to_ising_line = 'J=j_couplings,'
    var _to_ising_line = 'offset=offset,'
    var _to_ising_line = 'qubit_labels=dict(qubit_labels),'
    var _to_ising_line = 'n_qubits=n_qubits,'
    var _to_ising_line = 'source=f"{source} (QUBO→Ising)",'
    var _to_ising_line = ')'

fn compile(adjacency: Int, node_labels: Int, biases: Int, name: Int) -> Int:
    var _compile_line = 'self,'
    var _compile_line = 'adjacency: ndarray[Any, Any],'
    var _compile_line = 'node_labels: list[str] | 0 = 0,'
    var _compile_line = 'biases: ndarray[Any, Any] | 0 = 0,'
    var _compile_line = 'name: str = "sc_ising",'
    var _compile_line = ') -> IsingModel:'
    var _compile_line = 'n = adjacency.shape[0]'
    var _compile_line = 'labels = node_labels or [f"n{i}" for i in range(n)]'
    var _compile_line = 'bias_arr = biases if biases is not 0 else zeros(n)'
    var _compile_line = 'h: Dict[int, float] = {}'
    var _compile_line = 'j_couplings: Dict[tuple[int, int], float] = {}'
    var _compile_line = 'qubit_labels: Dict[int, str] = {}'
    var _compile_line = 'for i in range(n):'
    var _compile_line = 'qubit_labels[i] = labels[i]'
    var _compile_line = 'h[i] = float(bias_arr[i]) * _field_scale'
    var _compile_line = 'for i in range(n):'
    var _compile_line = 'for j in range(i + 1, n):'
    var _compile_line = 'w = float(adjacency[i, j] + adjacency[j, i]) / 2.0'
    var _compile_line = 'if abs(w) > 1e-12:'
    var _compile_line = '# Excitatory (w > 0) → J < 0 (ferromagnetic)'
    var _compile_line = 'j_couplings[(i, j)] = -w * _coupling_scale'
    return 0  # return IsingModel(
    var _compile_line = 'h=h,'
    var _compile_line = 'J=j_couplings,'
    var _compile_line = 'offset=0.0,'
    var _compile_line = 'qubit_labels=qubit_labels,'
    var _compile_line = 'n_qubits=n,'
    var _compile_line = 'source=name,'
    var _compile_line = ')'

fn compile(adjacency: Int, node_labels: Int, name: Int) -> Int:
    var _compile_line = 'self,'
    var _compile_line = 'adjacency: ndarray[Any, Any],'
    var _compile_line = 'node_labels: list[str] | 0 = 0,'
    var _compile_line = 'name: str = "sc_qubo",'
    var _compile_line = ') -> QUBOModel:'
    var _compile_line = 'n = adjacency.shape[0]'
    var _compile_line = 'labels = node_labels or [f"n{i}" for i in range(n)]'
    var _compile_line = 'q_matrix: Dict[tuple[int, int], float] = {}'
    var _compile_line = 'qubit_labels: Dict[int, str] = {}'
    var _compile_line = 'for i in range(n):'
    var _compile_line = 'qubit_labels[i] = labels[i]'
    var _compile_line = 'for i in range(n):'
    var _compile_line = 'for j in range(i, n):'
    var _compile_line = 'if i == j:'
    var _compile_line = '# Diagonal: self-bias (sum of incoming weights)'
    var _compile_line = 'q_matrix[(i, i)] = -float(sum(abs(adjacency[:, i])))'
    var _compile_line = 'else:'
    var _compile_line = 'w = float(adjacency[i, j] + adjacency[j, i]) / 2.0'
    var _compile_line = 'if abs(w) > 1e-12:'
    var _compile_line = 'q_matrix[(i, j)] = w * _penalty'
    return 0  # return QUBOModel(
    var _compile_line = 'Q=q_matrix,'
    var _compile_line = 'offset=0.0,'
    var _compile_line = 'qubit_labels=qubit_labels,'
    var _compile_line = 'n_qubits=n,'
    var _compile_line = 'source=name,'
    var _compile_line = ')'

