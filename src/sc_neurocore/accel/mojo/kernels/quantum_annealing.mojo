fn export_ising_json(model: Int, path: Int) -> Int:
    var _export_ising_json_line = 'data = {'
    var _export_ising_json_line = '"type": "ising",'
    var _export_ising_json_line = '"n_qubits": model.n_qubits,'
    var _export_ising_json_line = '"source": model.source,'
    var _export_ising_json_line = '"offset": model.offset,'
    var _export_ising_json_line = '"h": {str(k): v for k, v in model.h.items()},'
    var _export_ising_json_line = '"J": {f"{i},{j}": v for (i, j), v in model.J.items()},'
    var _export_ising_json_line = '"qubit_labels": {str(k): v for k, v in model.qubit_labels.it'
    var _export_ising_json_line = '}'
    var _export_ising_json_line = 'with open(path, "w") as f:'
    var _export_ising_json_line = 'json.dump(data, f, indent=2)'
    return 0

