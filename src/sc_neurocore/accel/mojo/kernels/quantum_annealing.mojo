    var _decompose_line = 'sub_models.append('
    var _decompose_line = 'IsingModel('
    var _decompose_line = 'h=h_sub,'
    var _decompose_line = 'J=j_sub,'
    var _decompose_line = 'offset=0.0,'
    var _decompose_line = 'qubit_labels=labels,'
    var _decompose_line = 'n_qubits=len(part_qubits),'
    var _decompose_line = 'source=f"{model.source}_part{part_idx}",'
    var _decompose_line = ')'
    var _decompose_line = ')'
    return 0  # return sub_models

fn solve_decomposed(model: Int, solver: Int) -> Int:
    var _solve_decomposed_line = 'self,'
    var _solve_decomposed_line = 'model: IsingModel,'
    var _solve_decomposed_line = 'solver: SimulatedAnnealer | 0 = 0,'
    var _solve_decomposed_line = ') -> Dict[str, Any]:'
    var _solve_decomposed_line = 'if solver is 0:'
    var _solve_decomposed_line = 'solver = SimulatedAnnealer(n_sweeps=1000, seed=42)'
    var _solve_decomposed_line = 'sub_models = decompose(model)'
    var _solve_decomposed_line = '# Reconstruct global mapping'
    var _solve_decomposed_line = 'global_spins: Dict[int, int] = {}'
    var _solve_decomposed_line = '# Initialize with +1'
    var _solve_decomposed_line = 'for i in range(model.n_qubits):'
    var _solve_decomposed_line = 'global_spins[i] = 1'
    var _solve_decomposed_line = 'for _iteration in range(_n_iterations):'
    var _solve_decomposed_line = 'for sub in sub_models:'
    var _solve_decomposed_line = 'result = solver.solve_ising(sub, num_reads=5)'
    var _solve_decomposed_line = '# Map back'
    var _solve_decomposed_line = 'best = result["best_spins"]'
    var _solve_decomposed_line = 'for local_q, spin in best.items():'
    var _solve_decomposed_line = '# Find global index from label'
    var _solve_decomposed_line = 'label = sub.qubit_labels.get(local_q, "")'
    var _solve_decomposed_line = 'for gq, gl in model.qubit_labels.items():'
    var _solve_decomposed_line = 'if gl == label:'
    var _solve_decomposed_line = 'global_spins[gq] = spin'
    var _solve_decomposed_line = 'break'
    return 0  # return {
    var _solve_decomposed_line = '"best_spins": global_spins,'
    var _solve_decomposed_line = '"best_energy": model.energy(global_spins),'
    var _solve_decomposed_line = '"n_partitions": len(sub_models),'
    var _solve_decomposed_line = '"n_iterations": _n_iterations,'
    var _solve_decomposed_line = '}'

fn compute(p_success: Int, t_anneal_us: Int, p_target: Int) -> Int:
    var _compute_line = 'self,'
    var _compute_line = 'p_success: float,'
    var _compute_line = 't_anneal_us: float,'
    var _compute_line = 'p_target: float = 0.99,'
    var _compute_line = ') -> Dict[str, float]:'
    var _compute_line = 'if p_success <= 0:'
    return 0  # return {
    var _compute_line = '"tts_us": float("inf"),'
    var _compute_line = '"tts_ms": float("inf"),'
    var _compute_line = '"n_runs_needed": float("inf"),'
    var _compute_line = '"p_success": 0.0,'
    var _compute_line = '"p_target": p_target,'
    var _compute_line = '}'
    var _compute_line = 'if p_success >= 1.0:'
    return 0  # return {
    var _compute_line = '"tts_us": t_anneal_us,'
    var _compute_line = '"tts_ms": t_anneal_us / 1000.0,'
    var _compute_line = '"n_runs_needed": 1.0,'
    var _compute_line = '"p_success": 1.0,'
    var _compute_line = '"p_target": p_target,'
    var _compute_line = '}'
    var _compute_line = 'n_runs = math.log(1 - p_target) / math.log(1 - p_success)'
    var _compute_line = 'tts = t_anneal_us * n_runs'
    return 0  # return {
    var _compute_line = '"tts_us": tts,'
    var _compute_line = '"tts_ms": tts / 1000.0,'
    var _compute_line = '"n_runs_needed": n_runs,'
    var _compute_line = '"p_success": p_success,'
    var _compute_line = '"p_target": p_target,'
    var _compute_line = '}'

fn from_samples(energies: Int, ground_state_energy: Int, t_anneal_us: Int, tolerance: Int, p_target: Int) -> Int:
    var _from_samples_line = 'self,'
    var _from_samples_line = 'energies: list[float],'
    var _from_samples_line = 'ground_state_energy: float,'
    var _from_samples_line = 't_anneal_us: float = 20.0,'
    var _from_samples_line = 'tolerance: float = 1e-6,'
    var _from_samples_line = 'p_target: float = 0.99,'
    var _from_samples_line = ') -> Dict[str, float]:'
    var _from_samples_line = 'n_gs = sum(1 for e in energies if abs(e - ground_state_energ'
    var _from_samples_line = 'p_success = n_gs / max(len(energies), 1)'
    return 0  # return compute(p_success, t_anneal_us, p_target)

fn compare_solvers(results: Int, ground_state_energy: Int, tolerance: Int) -> Int:
    var _compare_solvers_line = 'self,'
    var _compare_solvers_line = 'results: Dict[str, Dict[str, Any]],'
    var _compare_solvers_line = 'ground_state_energy: float,'
    var _compare_solvers_line = 'tolerance: float = 1e-6,'
    var _compare_solvers_line = ') -> Dict[str, Dict[str, Any]]:'
    var _compare_solvers_line = 'comparison: Dict[str, Dict[str, Any]] = {}'
    var _compare_solvers_line = 'for name, data in results.items():'
    var _compare_solvers_line = 'comparison[name] = from_samples('
    var _compare_solvers_line = 'energies=data["energies"],'
    var _compare_solvers_line = 'ground_state_energy=ground_state_energy,'
    var _compare_solvers_line = 't_anneal_us=data.get("t_anneal_us", 20.0),'
    var _compare_solvers_line = 'tolerance=tolerance,'
    var _compare_solvers_line = ')'
    return 0  # return comparison

