fn _cmd_serve(model_path: Int, port: Int, dt: Int) -> Int:
    var __cmd_serve_line = 'import os'
    var __cmd_serve_line = 'ext = os.path.splitext(model_path)[1].lower()'
    var __cmd_serve_line = 'if ext != ".nir":'
    var __cmd_serve_line = 'print(f"Error: serve currently supports .nir files only, got'
    return 0  # return 1
    var __cmd_serve_line = 'import nir as nir_lib'
    var __cmd_serve_line = 'from sc_neurocore.nir_bridge import from_nir'
    var __cmd_serve_line = 'from sc_neurocore.serve import SpikeServer'
    var __cmd_serve_line = 'graph = nir_lib.read(model_path)'
    var __cmd_serve_line = 'network = from_nir(graph, dt=dt)'
    var __cmd_serve_line = 'print(f"Loaded NIR graph with {len(network.topo_order)} node'
    var __cmd_serve_line = 'server = SpikeServer(network, port=port)'
    var __cmd_serve_line = 'server.start(blocking=True)'
    return 0  # return 0

