    var __cmd_compile_line = 'if not s:'
    return 0  # return 0
    var __cmd_compile_line = 'result = {}'
    var __cmd_compile_line = 'for pair in s.split(","):'
    var __cmd_compile_line = 'k, v = pair.strip().split("=")'
    var __cmd_compile_line = 'result[k.strip()] = float(v.strip())'
    return 0  # return result
    var __cmd_compile_line = 'params = _parse_kvpairs(args.params)'
    var __cmd_compile_line = 'init = _parse_kvpairs(args.init)'
