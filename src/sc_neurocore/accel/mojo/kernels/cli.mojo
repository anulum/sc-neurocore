fn _cmd_deploy(model_path: Int, target: Int, output_dir: Int, dt: Int, bitstream_length: Int) -> Int:
    var __cmd_deploy_line = 'model_path: str, target: str, output_dir: str, dt: float, bi'
    var __cmd_deploy_line = ') -> int:'
    var __cmd_deploy_line = 'import os'
    var __cmd_deploy_line = 'os.makedirs(output_dir, exist_ok=True)'
    var __cmd_deploy_line = 'print("SC-NeuroCore Deploy")'
    var __cmd_deploy_line = 'print(f"  Model:  {model_path}")'
    var __cmd_deploy_line = 'print(f"  Target: {target}")'
    var __cmd_deploy_line = 'print(f"  Output: {output_dir}")'
    var __cmd_deploy_line = 'print()'
    var __cmd_deploy_line = '# Step 1: Load model'
    var __cmd_deploy_line = 'ext = os.path.splitext(model_path)[1].lower()'
    var __cmd_deploy_line = 'if ext == ".nir":'
    var __cmd_deploy_line = 'print("[1/5] Loading NIR graph...")'
    var __cmd_deploy_line = 'import nir as nir_lib'
    var __cmd_deploy_line = 'from sc_neurocore.nir_bridge import from_nir'
    var __cmd_deploy_line = 'graph = nir_lib.read(model_path)'
    var __cmd_deploy_line = 'network = from_nir(graph, dt=dt)'
    var __cmd_deploy_line = 'print(f"  Loaded {len(network.topo_order)} nodes")'
    var __cmd_deploy_line = 'elif ext in (".pt", ".pth"):'
    var __cmd_deploy_line = 'print("[1/5] Loading PyTorch model and converting to SNN..."'
    var __cmd_deploy_line = 'import torch'
    var __cmd_deploy_line = 'from sc_neurocore.conversion import convert'
    var __cmd_deploy_line = 'state = torch.load(model_path, map_location="cpu", weights_o'
    var __cmd_deploy_line = 'layers: list[torch.nn.Module] = []'
    var __cmd_deploy_line = 'weight_keys = [k for k in state if k.endswith(".weight") and'
    var __cmd_deploy_line = 'for k in weight_keys:'
    var __cmd_deploy_line = 'w = state[k]'
    var __cmd_deploy_line = 'layers.append(torch.nn.Linear(w.shape[1], w.shape[0]))'
    var __cmd_deploy_line = 'layers.append(torch.nn.ReLU())'
    var __cmd_deploy_line = 'if layers and isinstance(layers[-1], torch.nn.ReLU):'
    var __cmd_deploy_line = 'layers.pop()'
    var __cmd_deploy_line = 'model = torch.nn.Sequential(*layers)'
    var __cmd_deploy_line = 'model.load_state_dict(state, strict=False)'
    var __cmd_deploy_line = 'in_dim = layers[0].in_features if layers else 1'
    var __cmd_deploy_line = 'cal_data = torch.randn(64, in_dim)  # type: ignore[arg-type]'
    var __cmd_deploy_line = 'snn = convert(model, calibration_data=cal_data, T=bitstream_'
    var __cmd_deploy_line = 'network = 0'
    var __cmd_deploy_line = 'print(f"  Converted {snn.n_layers}-layer SNN, T={snn.T}")'
    var __cmd_deploy_line = 'else:'
    var __cmd_deploy_line = 'print(f"Error: unsupported file format \'{ext}\'. Supported: .'
    return 0  # return 1
    var __cmd_deploy_line = '# Step 2: Quantize weights'
    var __cmd_deploy_line = 'print("[2/5] Quantizing weights to Q8.8...")'
    var __cmd_deploy_line = 'from sc_neurocore.compiler.equation_compiler import Q88'
    var __cmd_deploy_line = 'q = Q88()'
    var __cmd_deploy_line = 'print(f"  Q8.8: {q.data_width - q.fraction} integer + {q.fra'
    var __cmd_deploy_line = '# Step 3: Generate Verilog'
    var __cmd_deploy_line = 'print("[3/5] Generating SystemVerilog...")'
    var __cmd_deploy_line = 'from sc_neurocore.compiler.equation_compiler import equation'
    var __cmd_deploy_line = 'neuron, sv_code = equation_to_fpga('
    var __cmd_deploy_line = '"dv/dt = (-v + I) / tau",'
    var __cmd_deploy_line = 'threshold="v > 1.0",'
    var __cmd_deploy_line = 'reset="v = 0.0",'
    var __cmd_deploy_line = 'params={"tau": 20.0},'
    var __cmd_deploy_line = 'module_name="sc_deploy_lif",'
    var __cmd_deploy_line = ')'
    var __cmd_deploy_line = 'sv_path = os.path.join(output_dir, "sc_deploy_lif.sv")'
    var __cmd_deploy_line = 'with open(sv_path, "w") as f:'
    var __cmd_deploy_line = 'f.write(sv_code)'
    var __cmd_deploy_line = 'print(f"  Generated {len(sv_code)} chars -> {sv_path}")'
    var __cmd_deploy_line = '# Step 4: Copy HDL modules'
    var __cmd_deploy_line = 'print("[4/5] Copying HDL modules...")'
    var __cmd_deploy_line = 'hdl_src = os.path.join(os.path.dirname(__file__), "..", ".."'
    var __cmd_deploy_line = 'if not os.path.isdir(hdl_src):'
    var __cmd_deploy_line = 'hdl_src = os.path.join(os.path.dirname(__file__), "..", ".."'
    var __cmd_deploy_line = 'hdl_dst = os.path.join(output_dir, "hdl")'
    var __cmd_deploy_line = 'if os.path.isdir(hdl_src):'
    var __cmd_deploy_line = 'import shutil'
    var __cmd_deploy_line = 'if os.path.exists(hdl_dst):'
    var __cmd_deploy_line = 'shutil.rmtree(hdl_dst)'
    var __cmd_deploy_line = 'shutil.copytree(hdl_src, hdl_dst, ignore=shutil.ignore_patte'
    var __cmd_deploy_line = 'n_copied = len([f for f in os.listdir(hdl_dst) if f.endswith'
    var __cmd_deploy_line = 'print(f"  Copied {n_copied} Verilog modules to {hdl_dst}/")'
    var __cmd_deploy_line = 'else:'
    var __cmd_deploy_line = 'print("  Warning: HDL source directory not found, skipping c'
    var __cmd_deploy_line = '# Step 5: Generate project files'
    var __cmd_deploy_line = 'print("[5/5] Generating project files...")'
    var __cmd_deploy_line = '_generate_project(output_dir, target, "sc_deploy_lif")'
    var __cmd_deploy_line = '# Step 6: Auto-synthesize if open-source toolchain available'
    var __cmd_deploy_line = 'cfg = _TARGET_CONFIGS[target]'
    var __cmd_deploy_line = 'if cfg["tool"] == "yosys":'
    var __cmd_deploy_line = 'synth_ok = _auto_synthesize(output_dir, target, "sc_deploy_l'
    var __cmd_deploy_line = 'else:'
    var __cmd_deploy_line = 'synth_ok = False'
    var __cmd_deploy_line = 'print()'
    var __cmd_deploy_line = 'print(f"Deploy complete. Project in {output_dir}/")'
    var __cmd_deploy_line = 'if synth_ok:'
    var __cmd_deploy_line = 'print("Synthesis succeeded. Results in output directory.")'
    var __cmd_deploy_line = 'elif cfg["tool"] == "yosys":'
    var __cmd_deploy_line = 'print("Yosys not found. To synthesize manually:")'
    var __cmd_deploy_line = 'print(f"  cd {output_dir} && make synth")'
    var __cmd_deploy_line = 'else:'
    var __cmd_deploy_line = 'print("Vivado project generated. To synthesize:")'
    var __cmd_deploy_line = 'print(f"  cd {output_dir} && vivado -mode batch -source proj'
    return 0  # return 0

fn _auto_synthesize(output_dir: Int, target: Int, top_module: Int, cfg: Int) -> Int:
    var __auto_synthesize_line = 'import os'
    var __auto_synthesize_line = 'import shutil'
    var __auto_synthesize_line = 'import subprocess'
    var __auto_synthesize_line = 'yosys = shutil.which("yosys")'
    var __auto_synthesize_line = 'if not yosys:'
    return 0  # return False
    var __auto_synthesize_line = 'print()'
    var __auto_synthesize_line = 'print("[6/6] Running Yosys synthesis...")'
    var __auto_synthesize_line = 'verilog_files = " ".join('
    var __auto_synthesize_line = '['
    var __auto_synthesize_line = 'os.path.join("hdl", f)'
    var __auto_synthesize_line = 'for f in os.listdir(os.path.join(output_dir, "hdl"))'
    var __auto_synthesize_line = 'if f.endswith(".v")'
    var __auto_synthesize_line = ']'
    var __auto_synthesize_line = '+ [f"{top_module}.sv"]'
    var __auto_synthesize_line = ')'
    var __auto_synthesize_line = 'synth_cmd = f"synth_{cfg[\'family\']}"'
    var __auto_synthesize_line = 'yosys_script = ('
    var __auto_synthesize_line = 'f"read_verilog -sv {verilog_files}; "'
    var __auto_synthesize_line = 'f"{synth_cmd} -top {top_module}; "'
    var __auto_synthesize_line = 'f"write_json {top_module}.json; stat"'
    var __auto_synthesize_line = ')'
    var __auto_synthesize_line = 'result = subprocess.run('
    var __auto_synthesize_line = '[yosys, "-p", yosys_script],'
    var __auto_synthesize_line = 'cwd=output_dir,'
    var __auto_synthesize_line = 'capture_output=True,'
    var __auto_synthesize_line = 'text=True,'
    var __auto_synthesize_line = 'timeout=300,'
    var __auto_synthesize_line = ')'
    return 0  # if result.returncode == 0:
    var __auto_synthesize_line = 'for line in result.stdout.splitlines():'
    var __auto_synthesize_line = 'if any(k in line for k in ("Number of cells", "Number of wir'
    var __auto_synthesize_line = 'print(f"  {line.strip()}")'
    var __auto_synthesize_line = 'print(f"  Synthesis JSON: {os.path.join(output_dir, top_modu'
    var __auto_synthesize_line = '# Try place-and-route if nextpnr available'
    var __auto_synthesize_line = 'pnr_tool = shutil.which(f"nextpnr-{cfg[\'family\']}")'
    var __auto_synthesize_line = 'if pnr_tool:'
    var __auto_synthesize_line = 'print("  Running nextpnr place-and-route...")'
    var __auto_synthesize_line = 'pnr_result = subprocess.run('
    var __auto_synthesize_line = '['
    var __auto_synthesize_line = 'pnr_tool,'
    var __auto_synthesize_line = 'f"--{cfg[\'device\']}",'
    var __auto_synthesize_line = '"--json",'
    var __auto_synthesize_line = 'f"{top_module}.json",'
    var __auto_synthesize_line = '"--asc",'
    var __auto_synthesize_line = 'f"{top_module}.asc",'
    var __auto_synthesize_line = '"--package",'
    var __auto_synthesize_line = 'cfg["package"],'
    var __auto_synthesize_line = '],'
    var __auto_synthesize_line = 'cwd=output_dir,'
    var __auto_synthesize_line = 'capture_output=True,'
    var __auto_synthesize_line = 'text=True,'
    var __auto_synthesize_line = 'timeout=300,'
    var __auto_synthesize_line = ')'
    return 0  # if pnr_result.returncode == 0:
    var __auto_synthesize_line = 'print(f"  PnR succeeded: {top_module}.asc")'
    var __auto_synthesize_line = '# Try bitstream generation'
    var __auto_synthesize_line = 'pack_tool = "icepack" if cfg["family"] == "ice40" else "ecpp'
    var __auto_synthesize_line = 'pack_bin = shutil.which(pack_tool)'
