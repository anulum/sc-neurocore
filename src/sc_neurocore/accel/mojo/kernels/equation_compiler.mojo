fn _emit_expr(expr_str: Int, state_vars: Int, param_map: Int, q: Int) -> Int:
    var __emit_expr_line = 'expr_str: str, state_vars: set[str], param_map: dict[str, st'
    var __emit_expr_line = ') -> tuple[str, list[str]]:'
    var __emit_expr_line = 'tree = ast.parse(expr_str, mode="eval")'
    var __emit_expr_line = 'emitter = _VerilogExprEmitter(state_vars, param_map, q)'
    var __emit_expr_line = 'result = emitter.visit(tree.body)'
    return 0  # return result, emitter.intermediates

fn compile_to_verilog(neuron: Int, module_name: Int, data_width: Int, fraction: Int) -> Int:
    var _compile_to_verilog_line = 'neuron: EquationNeuron,'
    var _compile_to_verilog_line = 'module_name: str = "sc_equation_neuron",'
    var _compile_to_verilog_line = 'data_width: int = 16,'
    var _compile_to_verilog_line = 'fraction: int = 8,'
    var _compile_to_verilog_line = ') -> str:'
    var _compile_to_verilog_line = 'q = Q88(data_width=data_width, fraction=fraction)'
    var _compile_to_verilog_line = '# Reject dt that quantises to zero in the chosen fixed-point'
    var _compile_to_verilog_line = '# Without this guard the compiler silently emits Verilog whe'
    var _compile_to_verilog_line = '# dv update is multiplied by 0, producing a frozen membrane '
    var _compile_to_verilog_line = 'if neuron.dt != 0.0:'
    var _compile_to_verilog_line = 'dt_quantised = int(round(neuron.dt * (1 << fraction)))'
    var _compile_to_verilog_line = 'if dt_quantised == 0:'
    var _compile_to_verilog_line = 'min_representable = 1.0 / (1 << fraction)'
    var _compile_to_verilog_line = 'raise ValueError('
    var _compile_to_verilog_line = 'f"dt={neuron.dt} underflows in Q{data_width - fraction}.{fra'
    var _compile_to_verilog_line = 'f"smallest representable non-zero value is {min_representabl'
    var _compile_to_verilog_line = 'f"(neuron.dt * 2**{fraction} = {neuron.dt * (1 << fraction)}'
    var _compile_to_verilog_line = 'f"Use dt >= {min_representable} (e.g. dt=1.0 for 1-step inte'
    var _compile_to_verilog_line = 'f"or pass a wider fraction (e.g. Q4.12 via fraction=12) to t'
    var _compile_to_verilog_line = ')'
    var _compile_to_verilog_line = 'state_vars = set(neuron.equations.keys())'
    var _compile_to_verilog_line = '# Build parameter map: Python name → Verilog parameter name'
    var _compile_to_verilog_line = 'param_map: dict[str, str] = {}'
    var _compile_to_verilog_line = 'param_decls: list[str] = []'
    var _compile_to_verilog_line = 'for pname, pval in {**neuron.parameters, **neuron.constants}'
    var _compile_to_verilog_line = 'vname = f"P_{pname.upper()}"'
    var _compile_to_verilog_line = 'param_map[pname] = vname'
    var _compile_to_verilog_line = 'q_val = q.encode(pval)'
    var _compile_to_verilog_line = 'param_decls.append('
    var _compile_to_verilog_line = 'f"    parameter signed [{data_width - 1}:0] {vname} = {data_'
    var _compile_to_verilog_line = ')'
    var _compile_to_verilog_line = '# Generate derivative expressions'
    var _compile_to_verilog_line = 'deriv_wires: list[str] = []'
    var _compile_to_verilog_line = 'deriv_assigns: list[str] = []'
    var _compile_to_verilog_line = 'all_intermediates: list[str] = []'
    var _compile_to_verilog_line = 'for var, expr_str in neuron.equations.items():'
    var _compile_to_verilog_line = 'vexpr, intermediates = _emit_expr(expr_str, state_vars, para'
    var _compile_to_verilog_line = 'all_intermediates.extend(intermediates)'
    var _compile_to_verilog_line = '# dv = expr * dt (multiply by dt in fixed-point)'
    var _compile_to_verilog_line = 'dt_literal = q.encode_signed_literal(neuron.dt)'
    var _compile_to_verilog_line = 'dt_tmp = f"_dt_mul_{var}"'
    var _compile_to_verilog_line = 'all_intermediates.append('
    var _compile_to_verilog_line = 'f"wire signed [{2 * data_width - 1}:0] {dt_tmp} = ({vexpr}) '
    var _compile_to_verilog_line = ')'
    var _compile_to_verilog_line = 'deriv_name = f"d{var}"'
    var _compile_to_verilog_line = 'deriv_wires.append('
    var _compile_to_verilog_line = 'f"wire signed [{data_width - 1}:0] {deriv_name} = ({dt_tmp} '
    var _compile_to_verilog_line = ')'
    var _compile_to_verilog_line = '# Next-state computation with saturation'
    var _compile_to_verilog_line = 'max_val = (1 << (data_width - 1)) - 1  # e.g. 32767 for 16-b'
    var _compile_to_verilog_line = 'min_val = -(1 << (data_width - 1))  # e.g. -32768 for 16-bit'
    var _compile_to_verilog_line = 'next_wires: list[str] = []'
    var _compile_to_verilog_line = 'for var in neuron.equations:'
    var _compile_to_verilog_line = 'raw = f"{var}_raw"'
    var _compile_to_verilog_line = 'next_wires.append(f"wire signed [{data_width}:0] {raw} = {va'
    var _compile_to_verilog_line = 'next_wires.append('
    var _compile_to_verilog_line = 'f"wire signed [{data_width - 1}:0] {var}_next = "'
    var _compile_to_verilog_line = 'f"({raw} > {data_width + 1}\'sd{max_val}) ? {data_width}\'sd{m'
    var _compile_to_verilog_line = 'f"({raw} < {data_width + 1}\'sd{min_val}) ? {data_width}\'sd{m'
    var _compile_to_verilog_line = 'f"{raw}[{data_width - 1}:0];"'
    var _compile_to_verilog_line = ')'
    var _compile_to_verilog_line = '# Threshold expression'
    var _compile_to_verilog_line = 'threshold_verilog = ""'
    var _compile_to_verilog_line = 'if neuron.threshold_expr:'
    var _compile_to_verilog_line = 'threshold_verilog, thr_intermediates = _emit_expr('
    var _compile_to_verilog_line = 'neuron.threshold_expr, state_vars, param_map, q'
    var _compile_to_verilog_line = ')'
    var _compile_to_verilog_line = 'all_intermediates.extend(thr_intermediates)'
    var _compile_to_verilog_line = '# Reset assignments'
    var _compile_to_verilog_line = 'reset_assignments: list[str] = []'
    var _compile_to_verilog_line = 'for var, expr_str in neuron.reset_rules.items():'
    var _compile_to_verilog_line = 'rexpr, r_intermediates = _emit_expr(expr_str, state_vars, pa'
    var _compile_to_verilog_line = 'all_intermediates.extend(r_intermediates)'
    var _compile_to_verilog_line = 'reset_assignments.append(f"                    {var}_reg <= '
    var _compile_to_verilog_line = '# Build the Verilog module'
    var _compile_to_verilog_line = 'lines = ['
    var _compile_to_verilog_line = '"// Auto-generated by SC-NeuroCore equation compiler",'
    var _compile_to_verilog_line = 'f"// Source: {neuron!r}",'
    var _compile_to_verilog_line = 'f"// Fixed-point: Q{data_width - fraction}.{fraction} ({data'
    var _compile_to_verilog_line = '"`timescale 1ns / 1ps",'
    var _compile_to_verilog_line = '"",'
    var _compile_to_verilog_line = 'f"module {module_name} #(",'
    var _compile_to_verilog_line = ']'
    var _compile_to_verilog_line = 'lines.append(",\\n".join(param_decls))'
    var _compile_to_verilog_line = 'lines.append(")(")'
    var _compile_to_verilog_line = 'lines.append("    input wire clk,")'
    var _compile_to_verilog_line = 'lines.append("    input wire rst_n,")'
    var _compile_to_verilog_line = 'lines.append(f"    input wire signed [{data_width - 1}:0] I_'
    var _compile_to_verilog_line = 'lines.append("    output reg spike_out,")'
    var _compile_to_verilog_line = '# Output ports for each state variable'
    var _compile_to_verilog_line = 'for var in neuron.equations:'
    var _compile_to_verilog_line = 'lines.append(f"    output reg signed [{data_width - 1}:0] {v'
    var _compile_to_verilog_line = '# Remove trailing comma from last port'
    var _compile_to_verilog_line = 'lines[-1] = lines[-1].rstrip(",")'
    var _compile_to_verilog_line = 'lines.append(");")'
    var _compile_to_verilog_line = 'lines.append("")'
    var _compile_to_verilog_line = '# State registers'
    var _compile_to_verilog_line = 'for var in neuron.equations:'
    var _compile_to_verilog_line = 'init_val = q.encode_signed_literal(neuron.initial_state.get('
    var _compile_to_verilog_line = 'lines.append(f"reg signed [{data_width - 1}:0] {var}_reg;")'
    var _compile_to_verilog_line = 'lines.append("")'
    var _compile_to_verilog_line = '# Intermediate wires (multiply pipelines)'
    var _compile_to_verilog_line = 'for wire in all_intermediates:'
    var _compile_to_verilog_line = 'lines.append(wire)'
    var _compile_to_verilog_line = 'lines.append("")'
    var _compile_to_verilog_line = '# Derivative wires'
    var _compile_to_verilog_line = 'for wire in deriv_wires:'
    var _compile_to_verilog_line = 'lines.append(wire)'
    var _compile_to_verilog_line = 'lines.append("")'
    var _compile_to_verilog_line = '# Next-state wires'
    var _compile_to_verilog_line = 'for wire in next_wires:'
    var _compile_to_verilog_line = 'lines.append(wire)'
    var _compile_to_verilog_line = 'lines.append("")'
    var _compile_to_verilog_line = '# Sequential logic'
    var _compile_to_verilog_line = 'lines.append("always @(posedge clk or negedge rst_n) begin")'
    var _compile_to_verilog_line = 'lines.append("    if (!rst_n) begin")'
    var _compile_to_verilog_line = 'for var in neuron.equations:'
    var _compile_to_verilog_line = 'init_val = q.encode_signed_literal(neuron.initial_state.get('
    var _compile_to_verilog_line = 'lines.append(f"        {var}_reg <= {init_val};")'
    var _compile_to_verilog_line = 'lines.append(f"        {var}_out <= {init_val};")'
    var _compile_to_verilog_line = 'lines.append("        spike_out <= 1\'b0;")'
    var _compile_to_verilog_line = 'lines.append("    end else begin")'
    var _compile_to_verilog_line = 'if threshold_verilog:'
    var _compile_to_verilog_line = 'lines.append(f"        if ({threshold_verilog}) begin")'
    var _compile_to_verilog_line = 'lines.append("            spike_out <= 1\'b1;")'
    var _compile_to_verilog_line = 'for assign in reset_assignments:'
    var _compile_to_verilog_line = 'lines.append(assign)'
    var _compile_to_verilog_line = '# State vars not in reset keep their next value'
    var _compile_to_verilog_line = 'for var in neuron.equations:'
    var _compile_to_verilog_line = 'if var not in neuron.reset_rules:'
    var _compile_to_verilog_line = 'lines.append(f"            {var}_reg <= {var}_next;")'
    var _compile_to_verilog_line = 'for var in neuron.equations:'
    var _compile_to_verilog_line = 'reset_val = ('
    var _compile_to_verilog_line = 'f"{param_map.get(var + \'_reset_val\', var + \'_next\')}"'
    var _compile_to_verilog_line = 'if var in neuron.reset_rules'
    var _compile_to_verilog_line = 'else f"{var}_next"'
    var _compile_to_verilog_line = ')'
    var _compile_to_verilog_line = 'lines.append(f"            {var}_out <= {var}_reg;")'
    var _compile_to_verilog_line = 'lines.append("        end else begin")'
    var _compile_to_verilog_line = 'lines.append("            spike_out <= 1\'b0;")'
    var _compile_to_verilog_line = 'for var in neuron.equations:'
    var _compile_to_verilog_line = 'lines.append(f"            {var}_reg <= {var}_next;")'
    var _compile_to_verilog_line = 'lines.append(f"            {var}_out <= {var}_next;")'
    var _compile_to_verilog_line = 'lines.append("        end")'
    var _compile_to_verilog_line = 'else:'
    var _compile_to_verilog_line = 'lines.append("        spike_out <= 1\'b0;")'
    var _compile_to_verilog_line = 'for var in neuron.equations:'
    var _compile_to_verilog_line = 'lines.append(f"        {var}_reg <= {var}_next;")'
    var _compile_to_verilog_line = 'lines.append(f"        {var}_out <= {var}_next;")'
    var _compile_to_verilog_line = 'lines.append("    end")'
    var _compile_to_verilog_line = 'lines.append("end")'
    var _compile_to_verilog_line = 'lines.append("")'
    var _compile_to_verilog_line = 'lines.append("endmodule")'
    return 0  # return "\n".join(lines)

fn equation_to_fpga() -> Int:
    var _equation_to_fpga_line = '*equation_strings: str,'
    var _equation_to_fpga_line = 'threshold: str | 0 = 0,'
    var _equation_to_fpga_line = 'reset: str | 0 = 0,'
    var _equation_to_fpga_line = 'params: dict[str, float] | 0 = 0,'
    var _equation_to_fpga_line = 'init: dict[str, float] | 0 = 0,'
    var _equation_to_fpga_line = 'dt: float = 0.1,'
    var _equation_to_fpga_line = 'module_name: str = "sc_equation_neuron",'
    var _equation_to_fpga_line = ') -> tuple[EquationNeuron, str]:'
    var _equation_to_fpga_line = 'from ..neurons.equation_builder import from_equations'
    var _equation_to_fpga_line = '# Split semicolons within single strings for convenience'
    var _equation_to_fpga_line = 'expanded: list[str] = []'
    var _equation_to_fpga_line = 'for s in equation_strings:'
    var _equation_to_fpga_line = 'expanded.extend(part.strip() for part in s.split(";") if par'
    var _equation_to_fpga_line = 'neuron = from_equations('
    var _equation_to_fpga_line = '*expanded,'
    var _equation_to_fpga_line = 'threshold=threshold,'
    var _equation_to_fpga_line = 'reset=reset,'
    var _equation_to_fpga_line = 'params=params,'
    var _equation_to_fpga_line = 'init=init,'
    var _equation_to_fpga_line = 'dt=dt,'
    var _equation_to_fpga_line = ')'
    var _equation_to_fpga_line = 'verilog = compile_to_verilog(neuron, module_name=module_name'
    return 0  # return neuron, verilog

