fn encode(value: Int) -> Int:
    var _encode_line = 'raw = int(round(value * (1 << fraction)))'
    var _encode_line = 'mask = (1 << data_width) - 1'
    return 0  # return raw & mask

fn encode_signed_literal(value: Int) -> Int:
    var _encode_signed_literal_line = 'raw = int(round(value * (1 << fraction)))'
    var _encode_signed_literal_line = 'if raw < 0:'
    var _encode_signed_literal_line = 'raw = raw & ((1 << data_width) - 1)'
    return 0  # return f"{data_width}'sd{raw}"

