fn _heatmap_with_progress(simulate_fn: Int, base_config: Int, param_x: Int, x_vals: Int, param_y: Int, y_vals: Int) -> Int:
    var __heatmap_with_progress_line = 'simulate_fn: Callable[..., dict[str, Any]],'
    var __heatmap_with_progress_line = 'base_config: dict[str, Any],'
    var __heatmap_with_progress_line = 'param_x: str,'
    var __heatmap_with_progress_line = 'x_vals: list[float],'
    var __heatmap_with_progress_line = 'param_y: str,'
    var __heatmap_with_progress_line = 'y_vals: list[float],'
    var __heatmap_with_progress_line = 'q: queue.Queue[dict[str, Any]],'
    var __heatmap_with_progress_line = ') -> 0:'
    var __heatmap_with_progress_line = 'try:'
    var __heatmap_with_progress_line = 'total = len(x_vals) * len(y_vals)'
    var __heatmap_with_progress_line = 'rates = []'
    var __heatmap_with_progress_line = 'done = 0'
    var __heatmap_with_progress_line = 'params = base_config.get("params") or {}'
    var __heatmap_with_progress_line = 'for xi, xv in enumerate(x_vals):'
    var __heatmap_with_progress_line = 'row = []'
    var __heatmap_with_progress_line = 'for yi, yv in enumerate(y_vals):'
    var __heatmap_with_progress_line = 'pct = int((done / total) * 100)'
    var __heatmap_with_progress_line = 'q.put('
    var __heatmap_with_progress_line = '{'
    var __heatmap_with_progress_line = '"type": "progress",'
    var __heatmap_with_progress_line = '"step": "heatmap",'
    var __heatmap_with_progress_line = '"pct": pct,'
    var __heatmap_with_progress_line = '"msg": f"Sweep {done + 1}/{total}",'
    var __heatmap_with_progress_line = '}'
    var __heatmap_with_progress_line = ')'
    var __heatmap_with_progress_line = 'try:'
    var __heatmap_with_progress_line = 'sweep_params = {**params, param_x: float(xv), param_y: float'
    var __heatmap_with_progress_line = 'r = simulate_fn(**{**base_config, "params": sweep_params})'
    var __heatmap_with_progress_line = 'row.append(r["stats"]["rate_hz"])'
    var __heatmap_with_progress_line = 'except Exception:'
    var __heatmap_with_progress_line = 'row.append(0.0)'
    var __heatmap_with_progress_line = 'done += 1'
    var __heatmap_with_progress_line = 'rates.append(row)'
    var __heatmap_with_progress_line = 'all_rates = [r for row in rates for r in row]'
    var __heatmap_with_progress_line = 'result = {'
    var __heatmap_with_progress_line = '"param_x": param_x,'
    var __heatmap_with_progress_line = '"x_values": [float(v) for v in x_vals],'
    var __heatmap_with_progress_line = '"param_y": param_y,'
    var __heatmap_with_progress_line = '"y_values": [float(v) for v in y_vals],'
    var __heatmap_with_progress_line = '"rates": rates,'
    var __heatmap_with_progress_line = '"rate_min": round(min(all_rates), 2) if all_rates else 0,'
    var __heatmap_with_progress_line = '"rate_max": round(max(all_rates), 2) if all_rates else 0,'
    var __heatmap_with_progress_line = '}'
    var __heatmap_with_progress_line = 'q.put({"type": "complete", "pct": 100, "result": result})'
    var __heatmap_with_progress_line = 'except Exception as e:'
    var __heatmap_with_progress_line = 'q.put({"type": "error", "msg": str(e)})'
    return 0

