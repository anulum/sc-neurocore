fn decode(encoded_sequence: Int) -> Int:
    var _decode_line = 'total_block = _block_size + _n_parity'
    var _decode_line = 'data: list[str] = []'
    var _decode_line = 'corrections = 0'
    var _decode_line = 'for i in range(0, len(encoded_sequence), total_block):'
    var _decode_line = 'block = encoded_sequence[i : i + total_block]'
    var _decode_line = 'if len(block) < total_block:'
    var _decode_line = 'data.append(block[: _block_size])'
    var _decode_line = 'continue'
    var _decode_line = 'data_part = block[: _block_size]'
    var _decode_line = 'parity_part = block[_block_size :]'
    var _decode_line = 'symbols = [NUC_TO_GF4.get(c, 0) for c in data_part]'
    var _decode_line = 'expected = _compute_parity(symbols)'
    var _decode_line = 'actual = [NUC_TO_GF4.get(c, 0) for c in parity_part]'
    var _decode_line = 'syndrome = [(a - e) % 4 for a, e in zip(actual, expected)]'
    var _decode_line = 'if any(s != 0 for s in syndrome):'
    var _decode_line = 'corrections += 1'
    var _decode_line = 'error_pos = syndrome[0] % len(data_part) if syndrome[0] != 0'
    var _decode_line = 'corrected = list(data_part)'
    var _decode_line = 'corrected[error_pos] = GF4_TO_NUC['
    var _decode_line = '(NUC_TO_GF4[data_part[error_pos]] - syndrome[0]) % 4'
    var _decode_line = ']'
    var _decode_line = 'data.append("".join(corrected))'
    var _decode_line = 'else:'
    var _decode_line = 'data.append(data_part)'
    return 0  # return "".join(data), corrections

fn _compute_parity(symbols: Int) -> Int:
    var __compute_parity_line = 'parity = []'
    var __compute_parity_line = 'for j in range(_n_parity):'
    var __compute_parity_line = 'val = 0'
    var __compute_parity_line = 'for k, s in enumerate(symbols):'
    var __compute_parity_line = 'val = (val + s * pow(k + 1, j + 1, 251)) % 4'
    var __compute_parity_line = 'parity.append(val)'
    return 0  # return parity

fn check(design: Int) -> Int:
    var _check_line = 'all_strands = design.input_strands + design.output_strands +'
    var _check_line = 'for g in design.gates:'
