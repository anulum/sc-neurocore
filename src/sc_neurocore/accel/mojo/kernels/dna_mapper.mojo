fn _compute_k_eff(gate: Int, input_concentrations: Int) -> Int:
    var __compute_k_eff_line = 'self,'
    var __compute_k_eff_line = 'gate: "DNAGate",'
    var __compute_k_eff_line = 'input_concentrations: Dict[str, float],'
    var __compute_k_eff_line = ') -> float:'
    var __compute_k_eff_line = 'k_hyb = _arrhenius_scale(_k_hyb)'
    var __compute_k_eff_line = 'k_disp = _arrhenius_scale(_k_disp)'
    var __compute_k_eff_line = 'if gate.gate_type == GateType.AND:'
    var __compute_k_eff_line = 'inputs_conc = [input_concentrations.get(inp, 0.0) for inp in'
    var __compute_k_eff_line = 'input_present = all(c > 0.0 for c in inputs_conc)'
    var __compute_k_eff_line = 'k_eff = k_hyb * min(inputs_conc) * 1e-9 * (1.0 if input_pres'
    var __compute_k_eff_line = 'elif gate.gate_type == GateType.OR:'
    var __compute_k_eff_line = 'inputs_conc = [input_concentrations.get(inp, 0.0) for inp in'
    var __compute_k_eff_line = 'k_eff = k_hyb * max(inputs_conc) * 1e-9'
    var __compute_k_eff_line = 'elif gate.gate_type == GateType.NOT:'
    var __compute_k_eff_line = 'inp_conc = input_concentrations.get(gate.input_names[0], 0.0'
    var __compute_k_eff_line = 'k_eff = k_disp * (1.0 - min(inp_conc / 200.0, 1.0))'
    var __compute_k_eff_line = 'elif gate.gate_type == GateType.THRESHOLD:'
    var __compute_k_eff_line = 'inp_conc = input_concentrations.get(gate.input_names[0], 0.0'
    var __compute_k_eff_line = 'excess = max(0.0, inp_conc - gate.threshold * 200.0)'
    var __compute_k_eff_line = 'k_eff = k_hyb * excess * 1e-9'
    var __compute_k_eff_line = 'elif gate.gate_type == GateType.MUX:'
    var __compute_k_eff_line = 'sel = input_concentrations.get(gate.input_names[0], 0.0)'
    var __compute_k_eff_line = 'a = input_concentrations.get(gate.input_names[1], 0.0)'
    var __compute_k_eff_line = 'b = input_concentrations.get(gate.input_names[2], 0.0)'
    var __compute_k_eff_line = 'sel_frac = min(sel / 200.0, 1.0)'
    var __compute_k_eff_line = 'k_eff = k_hyb * (sel_frac * a + (1.0 - sel_frac) * b) * 1e-9'
    var __compute_k_eff_line = 'elif gate.gate_type == GateType.AMPLIFIER:'
    var __compute_k_eff_line = 'inp_conc = input_concentrations.get(gate.input_names[0], 0.0'
    var __compute_k_eff_line = 'k_eff = k_hyb * inp_conc * 1e-9 * 5.0  # catalytic turnover'
    var __compute_k_eff_line = 'elif gate.gate_type == GateType.BUFFER:'
    var __compute_k_eff_line = 'inp_conc = input_concentrations.get(gate.input_names[0], 0.0'
    var __compute_k_eff_line = 'k_eff = k_disp * min(inp_conc / 200.0, 1.0)'
    var __compute_k_eff_line = 'else:'
    var __compute_k_eff_line = 'k_eff = 0.0'
    return 0  # return k_eff + gate.leak_rate

fn simulate(design: Int, input_concentrations: Int, duration_s: Int, dt: Int) -> Int:
    var _simulate_line = 'self,'
    var _simulate_line = 'design: DNACircuitDesign,'
    var _simulate_line = 'input_concentrations: Dict[str, float],'
    var _simulate_line = 'duration_s: float = 3600.0,'
    var _simulate_line = 'dt: float = 1.0,'
    var _simulate_line = ') -> Dict[str, ndarray[Any, Any]]:'
    var _simulate_line = 'n_steps = int(duration_s / dt)'
    var _simulate_line = 'time = linspace(0.0, duration_s, n_steps)'
    var _simulate_line = 'outputs: Dict[str, ndarray[Any, Any]] = {"time": time}'
    var _simulate_line = 'max_conc = 200.0'
    var _simulate_line = 'for g in design.gates:'
    var _simulate_line = 'conc = zeros(n_steps)'
    var _simulate_line = 'k_eff = _compute_k_eff(g, input_concentrations)'
    var _simulate_line = 'if _integrator == "rk4":'
    var _simulate_line = 'for t in range(1, n_steps):'
    var _simulate_line = 'c = conc[t - 1]'
    var _simulate_line = 'k1 = k_eff * (max_conc - c) * dt'
    var _simulate_line = 'k2 = k_eff * (max_conc - (c + k1 / 2)) * dt'
    var _simulate_line = 'k3 = k_eff * (max_conc - (c + k2 / 2)) * dt'
    var _simulate_line = 'k4 = k_eff * (max_conc - (c + k3)) * dt'
    var _simulate_line = 'conc[t] = c + (k1 + 2 * k2 + 2 * k3 + k4) / 6'
    var _simulate_line = 'conc[t] = max(0.0, min(conc[t], max_conc))'
    var _simulate_line = 'else:'
    var _simulate_line = 'for t in range(1, n_steps):'
    var _simulate_line = 'd_conc = k_eff * (max_conc - conc[t - 1]) * dt'
    var _simulate_line = 'conc[t] = conc[t - 1] + d_conc'
    var _simulate_line = 'conc[t] = max(0.0, min(conc[t], max_conc))'
    var _simulate_line = 'outputs[g.output_name] = conc'
    return 0  # return outputs

