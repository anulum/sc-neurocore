    var _from_adjacency_line = 'node_names = [f"n{i}" for i in range(n)]'
    var _from_adjacency_line = 'gates: list[Dict[str, Any]] = []'
    var _from_adjacency_line = 'for j in range(n):'
    var _from_adjacency_line = 'if j in input_indices:'
    var _from_adjacency_line = 'continue'
    var _from_adjacency_line = 'sources = []'
    var _from_adjacency_line = 'for i in range(n):'
    var _from_adjacency_line = 'if adjacency[i, j] != 0:'
    var _from_adjacency_line = 'sources.append((i, float(adjacency[i, j])))'
    var _from_adjacency_line = 'if not sources:'
    var _from_adjacency_line = 'continue'
    var _from_adjacency_line = 'if len(sources) == 1:'
    var _from_adjacency_line = 'src_idx, w = sources[0]'
    var _from_adjacency_line = 'if w < 0:'
    var _from_adjacency_line = 'gates.append('
    var _from_adjacency_line = '{'
    var _from_adjacency_line = '"type": "NOT",'
    var _from_adjacency_line = '"inputs": [node_names[src_idx]],'
    var _from_adjacency_line = '"output": node_names[j],'
    var _from_adjacency_line = '}'
    var _from_adjacency_line = ')'
    var _from_adjacency_line = 'else:'
    var _from_adjacency_line = 'gates.append('
    var _from_adjacency_line = '{'
    var _from_adjacency_line = '"type": "BUFFER",'
    var _from_adjacency_line = '"inputs": [node_names[src_idx]],'
    var _from_adjacency_line = '"output": node_names[j],'
    var _from_adjacency_line = '}'
    var _from_adjacency_line = ')'
    var _from_adjacency_line = 'elif len(sources) == 2:'
    var _from_adjacency_line = 's0, s1 = sources[0], sources[1]'
    var _from_adjacency_line = 'if s0[1] > 0 and s1[1] > 0:'
    var _from_adjacency_line = 'gates.append('
    var _from_adjacency_line = '{'
    var _from_adjacency_line = '"type": "AND",'
    var _from_adjacency_line = '"inputs": [node_names[s0[0]], node_names[s1[0]]],'
    var _from_adjacency_line = '"output": node_names[j],'
    var _from_adjacency_line = '}'
    var _from_adjacency_line = ')'
    var _from_adjacency_line = 'elif s0[1] < 0 or s1[1] < 0:'
    var _from_adjacency_line = 'gates.append('
    var _from_adjacency_line = '{'
    var _from_adjacency_line = '"type": "OR",'
    var _from_adjacency_line = '"inputs": [node_names[s0[0]], node_names[s1[0]]],'
    var _from_adjacency_line = '"output": node_names[j],'
    var _from_adjacency_line = '}'
    var _from_adjacency_line = ')'
    var _from_adjacency_line = 'else:'
    var _from_adjacency_line = '# Multi-fan-in: chain AND gates'
    var _from_adjacency_line = 'prev = node_names[sources[0][0]]'
    var _from_adjacency_line = 'for k in range(1, len(sources)):'
    var _from_adjacency_line = 'out = f"{node_names[j]}_stage{k}" if k < len(sources) - 1 el'
    var _from_adjacency_line = 'gates.append('
    var _from_adjacency_line = '{'
    var _from_adjacency_line = '"type": "AND",'
    var _from_adjacency_line = '"inputs": [prev, node_names[sources[k][0]]],'
    var _from_adjacency_line = '"output": out,'
    var _from_adjacency_line = '}'
    var _from_adjacency_line = ')'
    var _from_adjacency_line = 'prev = out'
    var _from_adjacency_line = 'compiler = BitstreamToDNA(method=_method, seed=_seed)'
    return 0  # return compiler.compile_network(
    var _from_adjacency_line = 'gates=gates,'
    var _from_adjacency_line = 'input_names=[node_names[i] for i in input_indices],'
    var _from_adjacency_line = 'output_names=[node_names[i] for i in output_indices],'
    var _from_adjacency_line = 'name=name,'
    var _from_adjacency_line = ')'

fn check_strand(sequence: Int) -> Int:
    var _check_strand_line = 'hairpins: list[Dict[str, Any]] = []'
    var _check_strand_line = 'n = len(sequence)'
    var _check_strand_line = 'for i in range(n - _min_stem * 2 - _min_loop):'
    var _check_strand_line = 'for stem_len in range(_min_stem, min(12, (n - i) // 2)):'
    var _check_strand_line = 'loop_start = i + stem_len'
    var _check_strand_line = 'for loop_len in range('
    var _check_strand_line = '_min_loop,'
    var _check_strand_line = 'min(10, n - loop_start - stem_len + 1),'
    var _check_strand_line = '):'
    var _check_strand_line = 'j = loop_start + loop_len'
    var _check_strand_line = 'if j + stem_len > n:'
    var _check_strand_line = 'break'
    var _check_strand_line = '# Check complementarity of stem'
    var _check_strand_line = 'matches = 0'
    var _check_strand_line = 'for k in range(stem_len):'
    var _check_strand_line = 'left = sequence[i + k]'
    var _check_strand_line = 'right = sequence[j + stem_len - 1 - k]'
    var _check_strand_line = 'if _WC.get(left) == right:'
    var _check_strand_line = 'matches += 1'
    var _check_strand_line = 'if matches >= stem_len:'
    var _check_strand_line = 'dg_est = -1.5 * stem_len + 1.3  # rough estimate'
    var _check_strand_line = 'hairpins.append('
    var _check_strand_line = '{'
    var _check_strand_line = '"stem_start": i,'
    var _check_strand_line = '"stem_end": i + stem_len,'
    var _check_strand_line = '"loop_start": loop_start,'
    var _check_strand_line = '"loop_end": j,'
    var _check_strand_line = '"stem_length": stem_len,'
    var _check_strand_line = '"loop_length": loop_len,'
    var _check_strand_line = '"delta_g_estimate": dg_est,'
    var _check_strand_line = '}'
    var _check_strand_line = ')'
    return 0  # return hairpins

fn check_design(design: Int) -> Int:
    var _check_design_line = 'flags: list[Dict[str, Any]] = []'
    var _check_design_line = 'all_strands = list(design.input_strands) + list(design.outpu'
    var _check_design_line = 'for g in design.gates:'
