    var _check_line = '}'
    var _check_line = ')'
    return 0  # return flags

fn _longest_common_substring(a: Int, b: Int) -> Int:
    var __longest_common_substring_line = 'if not a or not b:'
    return 0  # return 0
    var __longest_common_substring_line = 'max_len = 0'
    var __longest_common_substring_line = 'prev = [0] * (len(b) + 1)'
    var __longest_common_substring_line = 'for i in range(len(a)):'
    var __longest_common_substring_line = 'curr = [0] * (len(b) + 1)'
    var __longest_common_substring_line = 'for j in range(len(b)):'
    var __longest_common_substring_line = 'if a[i] == b[j]:'
    var __longest_common_substring_line = 'curr[j + 1] = prev[j] + 1'
    var __longest_common_substring_line = 'max_len = max(max_len, curr[j + 1])'
    var __longest_common_substring_line = 'prev = curr'
    return 0  # return max_len

fn sensitivity_analysis(design: Int, input_concentrations: Int, duration_s: Int) -> Int:
    var _sensitivity_analysis_line = 'self,'
    var _sensitivity_analysis_line = 'design: DNACircuitDesign,'
    var _sensitivity_analysis_line = 'input_concentrations: Dict[str, float],'
    var _sensitivity_analysis_line = 'duration_s: float = 3600.0,'
    var _sensitivity_analysis_line = ') -> Dict[str, Any]:'
    var _sensitivity_analysis_line = 'sim = KineticSimulator()'
    var _sensitivity_analysis_line = 'output_keys = [g.output_name for g in design.gates]'
    var _sensitivity_analysis_line = 'results: Dict[str, list[float]] = {k: [] for k in output_key'
    var _sensitivity_analysis_line = 'for _ in range(_n_trials):'
    var _sensitivity_analysis_line = 'perturbed_conc = {'
    var _sensitivity_analysis_line = 'k: max(0.0, v * (1.0 + _rng.normal(0, _conc_cv)))'
    var _sensitivity_analysis_line = 'for k, v in input_concentrations.items()'
    var _sensitivity_analysis_line = '}'
    var _sensitivity_analysis_line = 'traces = sim.simulate(design, perturbed_conc, duration_s=dur'
    var _sensitivity_analysis_line = 'for k in output_keys:'
    var _sensitivity_analysis_line = 'if k in traces:'
    var _sensitivity_analysis_line = 'results[k].append(float(traces[k][-1]))'
    var _sensitivity_analysis_line = 'report: Dict[str, Any] = {"n_trials": _n_trials, "outputs": '
    var _sensitivity_analysis_line = 'for k, vals in results.items():'
    var _sensitivity_analysis_line = 'arr = array(vals)'
    var _sensitivity_analysis_line = 'report["outputs"][k] = {'
    var _sensitivity_analysis_line = '"mean": float(mean(arr)),'
    var _sensitivity_analysis_line = '"std": float(std(arr)),'
    var _sensitivity_analysis_line = '"cv": float(std(arr) / max(mean(arr), 1e-12)),'
    var _sensitivity_analysis_line = '"min": float(min(arr)),'
    var _sensitivity_analysis_line = '"max": float(max(arr)),'
    var _sensitivity_analysis_line = '"robust": bool(std(arr) / max(mean(arr), 1e-12) < 0.15),'
    var _sensitivity_analysis_line = '}'
    return 0  # return report

fn analyze(design: Int) -> Int:
    var _analyze_line = 'adj: Dict[str, list[str]] = {}'
    var _analyze_line = 'in_degree: Dict[str, int] = {}'
    var _analyze_line = 'all_nodes: set[str] = set()'
    var _analyze_line = 'for g in design.gates:'
    var _analyze_line = 'out = g.output_name'
    var _analyze_line = 'all_nodes.add(out)'
    var _analyze_line = 'adj.setdefault(out, [])'
    var _analyze_line = 'in_degree.setdefault(out, 0)'
    var _analyze_line = 'for inp in g.input_names:'
    var _analyze_line = 'all_nodes.add(inp)'
    var _analyze_line = 'adj.setdefault(inp, []).append(out)'
    var _analyze_line = 'in_degree[out] = in_degree.get(out, 0) + 1'
    var _analyze_line = 'in_degree.setdefault(inp, 0)'
    var _analyze_line = "# Kahn's algorithm for topological sort + cycle detection"
    var _analyze_line = 'queue = [n for n in all_nodes if in_degree.get(n, 0) == 0]'
    var _analyze_line = 'topo_order: list[str] = []'
    var _analyze_line = 'while queue:'
    var _analyze_line = 'node = queue.pop(0)'
    var _analyze_line = 'topo_order.append(node)'
    var _analyze_line = 'for neighbor in adj.get(node, []):'
    var _analyze_line = 'in_degree[neighbor] -= 1'
    var _analyze_line = 'if in_degree[neighbor] == 0:'
    var _analyze_line = 'queue.append(neighbor)'
    var _analyze_line = 'has_feedback = len(topo_order) < len(all_nodes)'
    var _analyze_line = 'cycles: list[list[str]] = []'
    var _analyze_line = 'if has_feedback:'
    var _analyze_line = 'remaining = all_nodes - set(topo_order)'
    var _analyze_line = 'cycles.append(sorted(remaining))'
    var _analyze_line = '# Compute depth via longest path in DAG'
    var _analyze_line = 'depth: Dict[str, int] = {n: 0 for n in all_nodes}'
    var _analyze_line = 'for node in topo_order:'
    var _analyze_line = 'for neighbor in adj.get(node, []):'
    var _analyze_line = 'depth[neighbor] = max(depth[neighbor], depth[node] + 1)'
    var _analyze_line = 'max_depth = max(depth.values()) if depth else 0'
    var _analyze_line = '# Fan-out'
    var _analyze_line = 'fan_out: Dict[str, int] = {}'
    var _analyze_line = 'for g in design.gates:'
    var _analyze_line = 'for inp in g.input_names:'
    var _analyze_line = 'fan_out[inp] = fan_out.get(inp, 0) + 1'
    var _analyze_line = '# Critical path'
    var _analyze_line = 'critical_path: list[str] = []'
    var _analyze_line = 'if depth:'
    var _analyze_line = 'current = max(depth, key=lambda x: depth[x])'
    var _analyze_line = 'critical_path = [current]'
    return 0  # return {
    var _analyze_line = '"depth": max_depth,'
    var _analyze_line = '"fan_out": fan_out,'
    var _analyze_line = '"has_feedback": has_feedback,'
    var _analyze_line = '"cycles": cycles,'
    var _analyze_line = '"topological_order": topo_order,'
    var _analyze_line = '"critical_path": critical_path,'
    var _analyze_line = '"n_nodes": len(all_nodes),'
    var _analyze_line = '}'

fn encode(design: Int, compiler: Int) -> Int:
    var _encode_line = 'self,'
    var _encode_line = 'design: DNACircuitDesign,'
    var _encode_line = 'compiler: BitstreamToDNA,'
    var _encode_line = ') -> DNACircuitDesign:'
    var _encode_line = 'dual_gates: list[Dict[str, Any]] = []'
    var _encode_line = 'for g in design.gates:'
    var _encode_line = '# True rail (original)'
    var _encode_line = 'dual_gates.append('
    var _encode_line = '{'
    var _encode_line = '"type": g.gate_type.value.upper(),'
    var _encode_line = '"inputs": g.input_names,'
    var _encode_line = '"output": f"{g.output_name}_T",'
    var _encode_line = '"threshold": g.threshold,'
    var _encode_line = '}'
    var _encode_line = ')'
    var _encode_line = '# Complement rail'
    var _encode_line = 'comp_type = _complement_gate_type(g.gate_type)'
    var _encode_line = 'comp_inputs = [f"{inp}_C" for inp in g.input_names]'
    var _encode_line = 'dual_gates.append('
    var _encode_line = '{'
    var _encode_line = '"type": comp_type,'
    var _encode_line = '"inputs": comp_inputs,'
    var _encode_line = '"output": f"{g.output_name}_C",'
    var _encode_line = '"threshold": g.threshold,'
    var _encode_line = '}'
    var _encode_line = ')'
    var _encode_line = 'all_inputs = []'
    var _encode_line = 'for s in design.input_strands:'
    var _encode_line = 'all_inputs.extend([f"{s.name}_T", f"{s.name}_C"])'
    var _encode_line = 'all_outputs = []'
    var _encode_line = 'for s in design.output_strands:'
    var _encode_line = 'all_outputs.extend([f"{s.name}_T", f"{s.name}_C"])'
    return 0  # return compiler.compile_network(
    var _encode_line = 'gates=dual_gates,'
    var _encode_line = 'input_names=all_inputs,'
    var _encode_line = 'output_names=all_outputs,'
    var _encode_line = 'name=f"{design.name}_dual_rail",'
    var _encode_line = ')'

fn check_faults(result: Int, threshold_nM: Int) -> Int:
    var _check_faults_line = 'self,'
    var _check_faults_line = 'result: Dict[str, ndarray[Any, Any]],'
    var _check_faults_line = 'threshold_nM: float = 50.0,'
    var _check_faults_line = ') -> list[Dict[str, Any]]:'
    var _check_faults_line = 'faults: list[Dict[str, Any]] = []'
    var _check_faults_line = 'signals: set[str] = set()'
    var _check_faults_line = 'for key in result:'
    var _check_faults_line = 'if key == "time":'
    var _check_faults_line = 'continue'
    var _check_faults_line = 'if key.endswith("_T") or key.endswith("_C"):'
    var _check_faults_line = 'signals.add(key[:-2])'
    var _check_faults_line = 'for sig in signals:'
    var _check_faults_line = 't_key = f"{sig}_T"'
    var _check_faults_line = 'c_key = f"{sig}_C"'
    var _check_faults_line = 'if t_key not in result or c_key not in result:'
    var _check_faults_line = 'continue'
    var _check_faults_line = 't_final = float(result[t_key][-1])'
    var _check_faults_line = 'c_final = float(result[c_key][-1])'
    var _check_faults_line = 't_high = t_final > threshold_nM'
    var _check_faults_line = 'c_high = c_final > threshold_nM'
    var _check_faults_line = 'if t_high == c_high:  # both high or both low'
    var _check_faults_line = 'faults.append('
    var _check_faults_line = '{'
    var _check_faults_line = '"signal": sig,'
    var _check_faults_line = '"true_nM": t_final,'
    var _check_faults_line = '"comp_nM": c_final,'
    var _check_faults_line = '"fault_type": "stuck_high" if t_high else "stuck_low",'
    var _check_faults_line = '}'
    var _check_faults_line = ')'
    return 0  # return faults

fn _complement_gate_type(gate_type: Int) -> Int:
    var __complement_gate_type_line = 'mapping = {'
