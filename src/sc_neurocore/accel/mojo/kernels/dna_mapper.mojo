fn layout(design: Int) -> Int:
    var _layout_line = '# Collect unique oligos'
    var _layout_line = 'seen: set[str] = set()'
    var _layout_line = 'unique_oligos: list[Dict[str, str]] = []'
    var _layout_line = 'all_strands = list(design.input_strands) + list(design.outpu'
    var _layout_line = 'for g in design.gates:'
    var _layout_line = 'all_strands.extend(g.strands)'
    var _layout_line = 'for s in all_strands:'
    var _layout_line = 'if s.sequence and s.sequence not in seen:'
    var _layout_line = 'seen.add(s.sequence)'
    var _layout_line = 'unique_oligos.append('
    var _layout_line = '{'
    var _layout_line = '"name": s.name,'
    var _layout_line = '"sequence": s.sequence,'
    var _layout_line = '"length": str(s.length),'
    var _layout_line = '}'
    var _layout_line = ')'
    var _layout_line = '# Assign to wells'
    var _layout_line = 'plates: list[list[Dict[str, str]]] = []'
    var _layout_line = 'current_plate: list[Dict[str, str]] = []'
    var _layout_line = 'for i, oligo in enumerate(unique_oligos):'
    var _layout_line = 'plate_idx = i // _n_wells'
    var _layout_line = 'well_idx = i % _n_wells'
    var _layout_line = 'row = _ROWS[well_idx // 12]'
    var _layout_line = 'col = _COLS[well_idx % 12]'
    var _layout_line = 'entry = {'
    var _layout_line = '"well": f"{row}{col:02d}",'
    var _layout_line = '"plate": plate_idx + 1,'
    var _layout_line = '**oligo,'
    var _layout_line = '}'
    var _layout_line = 'if well_idx == 0 and current_plate:'
    var _layout_line = 'plates.append(current_plate)'
    var _layout_line = 'current_plate = []'
    var _layout_line = 'current_plate.append(entry)'
    var _layout_line = 'if current_plate:'
    var _layout_line = 'plates.append(current_plate)'
    var _layout_line = 'n_plates = len(plates)'
    var _layout_line = 'total_wells = n_plates * _n_wells'
    var _layout_line = 'utilization = len(unique_oligos) / max(total_wells, 1) * 100'
    var _layout_line = '# CSV manifest'
    var _layout_line = 'manifest_lines = ["Well,Name,Sequence,Length"]'
    var _layout_line = 'for plate in plates:'
    var _layout_line = 'for entry in plate:'
    var _layout_line = 'manifest_lines.append('
    var _layout_line = 'f"{entry[\'well\']},{entry[\'name\']},{entry[\'sequence\']},{entry'
    var _layout_line = ')'
    return 0  # return {
    var _layout_line = '"plates": plates,'
    var _layout_line = '"n_plates": n_plates,'
    var _layout_line = '"n_unique_oligos": len(unique_oligos),'
    var _layout_line = '"utilization_pct": utilization,'
    var _layout_line = '"manifest_csv": "\\n".join(manifest_lines),'
    var _layout_line = '}'

fn score_fn(conc_scale: Int) -> Int:
    var _score_fn_line = 'total_err = 0.0'
    var _score_fn_line = 'for entry in truth_table:'
    var _score_fn_line = 'scaled = {k: v * conc_scale for k, v in entry["inputs"].item'
    var _score_fn_line = 'result = sim.simulate(design, scaled, duration_s=duration_s)'
    var _score_fn_line = 'for out_name, expected in entry["expected"].items():'
    var _score_fn_line = 'if out_name in result:'
    var _score_fn_line = 'final = float(result[out_name][-1])'
    var _score_fn_line = 'target = 150.0 if expected == "high" else 20.0'
    var _score_fn_line = 'total_err += (final - target) ** 2'
    return 0  # return total_err

