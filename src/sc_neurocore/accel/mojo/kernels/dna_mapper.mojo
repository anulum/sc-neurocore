fn generate(length: Int, name: Int) -> Int:
    var _generate_line = 'nucs = ["A", "C", "G", "T"]'
    var _generate_line = 'best_seq = ""'
    var _generate_line = 'best_score = float("inf")'
    var _generate_line = 'seed_hash = int(hashlib.sha256(name.encode()).hexdigest()[:8'
    var _generate_line = 'rng = random.default_rng(_rng.integers(0, 2**31) + seed_hash'
    var _generate_line = 'for _attempt in range(200):'
    var _generate_line = 'seq: list[str] = []'
    var _generate_line = 'gc_count = 0'
    var _generate_line = 'for i in range(length):'
    var _generate_line = '# Determine allowed nucleotides'
    var _generate_line = 'allowed = list(nucs)'
    var _generate_line = '# Prevent homopolymer runs'
    var _generate_line = 'if len(seq) >= _max_homopolymer:'
    var _generate_line = 'last_n = seq[-_max_homopolymer :]'
    var _generate_line = 'if len(set(last_n)) == 1:'
    var _generate_line = 'allowed = [n for n in allowed if n != last_n[0]]'
    var _generate_line = '# Bias toward GC target'
    var _generate_line = 'if i > 0:'
    var _generate_line = 'current_gc = gc_count / i'
    var _generate_line = 'if current_gc < _gc_target[0]:'
    var _generate_line = '# Need more GC'
    var _generate_line = 'weights = [0.15, 0.35, 0.35, 0.15]'
    var _generate_line = 'elif current_gc > _gc_target[1]:'
    var _generate_line = '# Need more AT'
    var _generate_line = 'weights = [0.35, 0.15, 0.15, 0.35]'
    var _generate_line = 'else:'
    var _generate_line = 'weights = [0.25, 0.25, 0.25, 0.25]'
    var _generate_line = '# Zero out disallowed'
    var _generate_line = 'weights = [w if nucs[j] in allowed else 0.0 for j, w in enum'
    var _generate_line = 'else:'
    var _generate_line = 'weights = [1.0 if n in allowed else 0.0 for n in nucs]'
    var _generate_line = 'total = sum(weights)'
    var _generate_line = 'if total == 0:'
    var _generate_line = 'weights = [1.0 / len(nucs)] * len(nucs)'
    var _generate_line = 'total = 1.0'
    var _generate_line = 'probs = [w / total for w in weights]'
    var _generate_line = 'nuc = rng.choice(nucs, p=probs)'
    var _generate_line = 'seq.append(nuc)'
    var _generate_line = 'if nuc in "GC":'
    var _generate_line = 'gc_count += 1'
    var _generate_line = 'candidate = "".join(seq)'
    var _generate_line = 'gc = gc_count / length'
    var _generate_line = 'score = abs(gc - 0.5) * 10'
    var _generate_line = '# Penalize homopolymer runs'
    var _generate_line = 'max_run = 1'
    var _generate_line = 'cur_run = 1'
    var _generate_line = 'for i in range(1, len(candidate)):'
    var _generate_line = 'if candidate[i] == candidate[i - 1]:'
    var _generate_line = 'cur_run += 1'
    var _generate_line = 'max_run = max(max_run, cur_run)'
    var _generate_line = 'else:'
    var _generate_line = 'cur_run = 1'
    var _generate_line = 'if max_run > _max_homopolymer:'
    var _generate_line = 'score += (max_run - _max_homopolymer) * 5'
    var _generate_line = '# Penalize similarity to existing sequences'
    var _generate_line = 'for existing in _used_sequences:'
    var _generate_line = 'overlap = sum(1 for a, b in zip(candidate, existing) if a =='
    var _generate_line = 'similarity = overlap / max(len(candidate), len(existing), 1)'
    var _generate_line = 'if similarity > 0.7:'
    var _generate_line = 'score += similarity * 10'
    var _generate_line = 'if score < best_score:'
    var _generate_line = 'best_score = score'
    var _generate_line = 'best_seq = candidate'
    var _generate_line = 'if score < 0.5:'
    var _generate_line = 'break'
    var _generate_line = '_used_sequences.append(best_seq)'
    return 0  # return best_seq

