    var _optimize_line = 'scaled = {k: v * conc_scale for k, v in entry["inputs"].item'
    var _optimize_line = 'result = sim.simulate(design, scaled, duration_s=duration_s)'
    var _optimize_line = 'for out_name, expected in entry["expected"].items():'
    var _optimize_line = 'if out_name in result:'
    var _optimize_line = 'final = float(result[out_name][-1])'
    var _optimize_line = 'target = 150.0 if expected == "high" else 20.0'
    var _optimize_line = 'total_err += (final - target) ** 2'
    return 0  # return total_err
    var _optimize_line = 'initial_score = score_fn(1.0)'
    var _optimize_line = 'best_scale = 1.0'
    var _optimize_line = 'best_score = initial_score'
    var _optimize_line = 'for _ in range(_max_eval):'
    var _optimize_line = 'candidate = 0.5 + _rng.random() * 1.5'
    var _optimize_line = 's = score_fn(candidate)'
    var _optimize_line = 'if s < best_score:'
    var _optimize_line = 'best_score = s'
    var _optimize_line = 'best_scale = candidate'
    var _optimize_line = 'improvement = (1.0 - best_score / max(initial_score, 1e-12))'
    return 0  # return {
    var _optimize_line = '"best_score": float(best_score),'
    var _optimize_line = '"initial_score": float(initial_score),'
    var _optimize_line = '"improvement_pct": float(max(0, improvement)),'
    var _optimize_line = '"n_evaluations": _max_eval,'
    var _optimize_line = '"best_scale": float(best_scale),'
    var _optimize_line = '}'

fn from_adjacency(adjacency: Int, input_indices: Int, output_indices: Int, name: Int) -> Int:
    var _from_adjacency_line = 'self,'
    var _from_adjacency_line = 'adjacency: ndarray[Any, Any],'
    var _from_adjacency_line = 'input_indices: list[int],'
