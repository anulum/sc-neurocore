{
  "metadata": {
    "schema_version": 1,
    "name": "EscapeRateNeuron",
    "author": "Gerstner, W.",
    "year": 2000,
    "doi": "10.1162/089976600300015899",
    "description": "Stochastic threshold neuron — spike probability via escape noise"
  },
  "state": { "v": -70.0 },
  "parameters": {
    "v_rest": -70.0, "v_reset": -70.0, "v_threshold": -50.0,
    "tau_m": 10.0, "rho_0": 0.001, "delta_u": 3.0, "resistance": 1.0
  },
  "integration": { "dt": 1.0, "method": "exp_euler" },
  "dynamics": { "v": "(-(v - v_rest) + resistance * I) / tau_m" },
  "threshold": {
    "condition": "stochastic", "detection": "escape_rate",
    "rate_expression": "rho_0 * exp(clip((v - v_threshold) / delta_u, -700.0, 700.0))",
    "rng_seed": 44257
  },
  "reset": { "v": "v_reset" },
  "extensions": { "noise_type": "escape_rate", "stochastic": true },
  "profile": {
    "contract": "sc-neurocore.model-profile.v1",
    "time_unit": "ms",
    "exactness": "exact-linear-relaxation",
    "notes": "Exponential Euler is the exact constant-current flow of the linear membrane. After the step the hazard rate * dt becomes the probability 1 - exp(-hazard) and the model-scoped LFSR16 seeded from threshold.rng_seed decides the event.",
    "state": {
      "v": "biological"
    },
    "parameters": {
      "v_rest": "source",
      "v_reset": "source",
      "v_threshold": "source",
      "tau_m": "source",
      "rho_0": "source",
      "delta_u": "source",
      "resistance": "source"
    },
    "units": {
      "v": "mV",
      "v_rest": "mV",
      "v_reset": "mV",
      "v_threshold": "mV",
      "tau_m": "ms",
      "rho_0": "1/ms",
      "delta_u": "mV",
      "resistance": "mV/current-unit"
    }
  }
}
