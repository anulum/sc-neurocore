# SC-NeuroCore — Hardware catalogue exact coverage

[run]
branch = True
source_dirs = src/sc_neurocore/studio
parallel = True
patch =
    subprocess
    _exit

[report]
include =
    */sc_neurocore/studio/hardware_catalogue.py
    */sc_neurocore/studio/synthesis_profiles.py
    */sc_neurocore/studio/api/hardware.py
fail_under = 100
show_missing = True
