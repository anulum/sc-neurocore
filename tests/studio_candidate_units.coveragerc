# SC-NeuroCore — Candidate dimensional admission exact branch coverage

[run]
branch = True
source_dirs =
    src/sc_neurocore/studio
    src/sc_neurocore/neurons
parallel = True
patch =
    subprocess
    _exit

[report]
include =
    */sc_neurocore/studio/candidate_unit_values.py
    */sc_neurocore/studio/candidate_unit_functions.py
    */sc_neurocore/studio/candidate_unit_expressions.py
    */sc_neurocore/studio/candidate_units.py
    */sc_neurocore/neurons/equation_units_runtime.py
fail_under = 100
show_missing = True
